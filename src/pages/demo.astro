---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeitenKopf from '../components/SeitenKopf.astro';
import ConceptCase from '../components/ConceptCase.astro';
import Marke from '../components/Marke.astro';
import AbschlussCTA from '../components/AbschlussCTA.astro';
import { demoStationen } from '../data/inhalte';
import { site } from '../config/site';

/** Muster, die auf vielen Handwerksseiten vorkommen — gegenübergestellt.
 *  Bewusst textlich und schematisch: kein Screenshot einer fremden Seite,
 *  kein „Vorher", das einen realen Betrieb suggerieren würde. */
const muster = [
  {
    verbreitet: 'Startseite listet alle Leistungen in einem Absatz',
    stattdessen: 'Jede Leistung bekommt eine eigene Seite mit eigener Suchabsicht',
  },
  {
    verbreitet: 'Bildergalerie ohne Erklärung, was zu sehen ist',
    stattdessen: 'Projekte mit Ort, Jahr und Aufgabenstellung',
  },
  {
    verbreitet: 'Kontaktformular ganz unten, Telefonnummer im Impressum',
    stattdessen: 'Anfrage nie mehr als einen Bildschirm entfernt, Nummer immer sichtbar',
  },
  {
    verbreitet: 'Stockfotos von Handwerkern mit verschränkten Armen',
    stattdessen: 'Detailaufnahmen echter Arbeit: Falz, Traufe, Anschluss',
  },
  {
    verbreitet: 'Sternebanner und Auszeichnungen ohne Quelle',
    stattdessen: 'Überprüfbare Merkmale: Meisterbetrieb, eigenes Team, Festpreis nach Aufmaß',
  },
  {
    verbreitet: 'Auf dem Telefon eine zusammengeschobene Desktopseite',
    stattdessen: 'Eigene mobile Komposition für Hero, Navigation und Anfrage',
  },
];
---

<BaseLayout
  title="Concept Case — eine komplette Dachdecker-Website"
  description="Ein vollständig gebauter Dachdeckerauftritt als Demonstrationsprojekt — fiktiver Betrieb, echte Umsetzung. So kann ein moderner Dachdecker-Auftritt aussehen."
  path="/demo"
>
  <SeitenKopf
    marke="Concept Case"
    titel="Eine komplette Dachdecker-Website — für einen Betrieb, den es"
    akzent="nicht gibt."
    text="Wir haben keine Kundenreferenzen, die wir zeigen könnten, und erfinden auch keine. Was wir zeigen können, ist ein vollständig gebauter Auftritt: jede Seite, jede Entscheidung, jede Zeile echt gebaut — nur der Betrieb dahinter ist frei erfunden."
  />

  <ConceptCase nr="01" kompakt={true} />

  <!-- Stationen mit ausführlicher Begründung -->
  <section class="abschnitt border-t border-linie bg-schiefer" aria-labelledby="stationen-titel">
    <div class="shell">
      <div class="grid gap-y-12 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-3">
          <Marke nr="02" label="Die Entscheidungen" />
        </div>
        <div class="lg:col-span-9 xl:col-span-8">
          <h2 id="stationen-titel" class="steig text-display">
            Sechs Stellen, an denen sich entscheidet, ob eine Anfrage
            <span class="text-schnur-hell">entsteht</span>.
          </h2>
        </div>
      </div>

      <ol class="mt-16 space-y-20 lg:mt-24 lg:space-y-28">
        {
          demoStationen.map((station, i) => (
            <li class="grid gap-y-8 lg:grid-cols-12 lg:gap-8">
              <div class="lg:col-span-3">
                <p class="steig marke">
                  <span class="marke-num zahlen">{station.nr}</span>
                  <span>{station.titel}</span>
                </p>
                <p class="steig mt-5 text-lead text-kalk" style="--i:1">
                  {station.kurz}
                </p>
                <p class="steig mt-4 text-klein text-zink" style="--i:2">
                  {station.text}
                </p>
              </div>

              <div class="lg:col-span-9">
                <figure class="steig border border-linie-stark bg-blei">
                  <img
                    src={station.bild}
                    width="1100"
                    height="640"
                    alt={`Ausschnitt der Dachdecker-Demo: ${station.titel}`}
                    class="w-full"
                    loading={i < 2 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </figure>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Verbreitete Muster gegenübergestellt -->
  <section class="abschnitt border-t border-linie bg-blei" aria-labelledby="muster-titel">
    <div class="shell">
      <div class="grid gap-y-12 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-3">
          <Marke nr="03" label="Muster" />
        </div>

        <div class="lg:col-span-9 xl:col-span-8">
          <h2 id="muster-titel" class="steig text-display">
            Was viele Handwerksseiten tun — und was wir
            <span class="text-schnur-hell">stattdessen</span> bauen.
          </h2>
          <p class="steig measure-wide mt-8 text-klein text-zink" style="--i:1">
            Bewusst ohne Gegenüberstellung einer echten fremden Website: Wir zeigen keine
            Seite eines realen Betriebs als Negativbeispiel, und ein „Vorher" gibt es hier
            nicht, weil es keinen realen Vorher-Zustand gab.
          </p>

          <div class="mt-12 border-t border-linie">
            {
              muster.map((m, i) => (
                <div
                  class="steig grid gap-x-10 gap-y-3 border-b border-linie py-6 md:grid-cols-2"
                  style={`--i:${Math.min(i, 4)}`}
                >
                  <p class="flex gap-3 text-klein text-zink">
                    <span
                      class="mt-[0.6em] h-px w-4 shrink-0 bg-rotstift-hell"
                      aria-hidden="true"
                    />
                    <span class="line-through decoration-rotstift-hell/50">
                      {m.verbreitet}
                    </span>
                  </p>
                  <p class="flex gap-3 text-klein text-kalk">
                    <span
                      class="mt-[0.6em] h-px w-4 shrink-0 bg-gruen-hell"
                      aria-hidden="true"
                    />
                    {m.stattdessen}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Übertragung auf den eigenen Betrieb -->
  <section class="hell abschnitt" aria-labelledby="uebertragung-titel">
    <div class="shell">
      <div class="grid gap-y-12 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-3">
          <Marke nr="04" label="Für Ihren Betrieb" />
        </div>
        <div class="lg:col-span-9 xl:col-span-7">
          <h2 id="uebertragung-titel" class="steig text-display">
            So würden wir es für Ihren Betrieb anpassen.
          </h2>
          <div class="mt-8 space-y-5 text-lead">
            <p class="steig" style="--i:1">
              Die Demo ist kein Template, das wir Ihnen mit ausgetauschtem Logo verkaufen.
              Sie zeigt ein Qualitätsniveau und eine Denkweise — der konkrete Aufbau
              ergibt sich aus Ihrem Aufmaß.
            </p>
            <p class="steig" style="--i:2">
              Ein Betrieb, der überwiegend Flachdächer für Gewerbekunden macht, bekommt
              eine andere Startseite als einer, der von privaten Steildachsanierungen
              lebt. Die Fotografie kommt von Ihren eigenen Baustellen, nicht aus einer
              Bilddatenbank. Und die Leistungen, die nach vorn kommen, sind die mit der
              besten Marge in Ihrem Gebiet — nicht die, die am häufigsten angefragt werden.
            </p>
          </div>

          <div class="steig mt-10" style="--i:3">
            <a
              href={site.demoUrl}
              target="_blank"
              rel="noopener"
              data-ereignis="demo_open"
              class="btn"
            >
              Live-Demo öffnen
              <svg viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5" aria-hidden="true">
                <path
                  d="M7 17 17 7M9 7h8v8"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="square"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <AbschlussCTA
    titel="Soll Ihr Auftritt so aussehen?"
    text="In der Potenzialanalyse sehen wir uns an, welche Leistungen bei Ihnen nach vorn gehören und was ein solcher Auftritt in Ihrem Einzugsgebiet bewirken kann."
  />
</BaseLayout>
