---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeitenKopf from '../components/SeitenKopf.astro';
import ConceptCase from '../components/ConceptCase.astro';
import Marke from '../components/Marke.astro';
import AbschlussCTA from '../components/AbschlussCTA.astro';
import { demoStationen } from '../data/inhalte';
import { site } from '../config/site';

/** Muster, die auf vielen Handwerksseiten vorkommen — gegenübergestellt.
 *  Bewusst textlich und schematisch: kein Screenshot einer fremden Seite,
 *  kein „Vorher", das einen realen Betrieb suggerieren würde. */
const muster = [
  {
    verbreitet: 'Startseite listet alle Leistungen in einem Absatz',
    stattdessen: 'Jede Leistung bekommt eine eigene Seite mit eigener Suchabsicht',
  },
  {
    verbreitet: 'Bildergalerie ohne Erklärung, was zu sehen ist',
    stattdessen: 'Projekte mit Ort, Jahr und Aufgabenstellung',
  },
  {
    verbreitet: 'Kontaktformular ganz unten, Telefonnummer im Impressum',
    stattdessen: 'Anfrage nie mehr als einen Bildschirm entfernt, Nummer immer sichtbar',
  },
  {
    verbreitet: 'Stockfotos von Handwerkern mit verschränkten Armen',
    stattdessen: 'Detailaufnahmen echter Arbeit: Falz, Traufe, Anschluss',
  },
  {
    verbreitet: 'Sternebanner und Auszeichnungen ohne Quelle',
    stattdessen: 'Überprüfbare Merkmale: Meisterbetrieb, eigenes Team, Festpreis nach Aufmaß',
  },
  {
    verbreitet: 'Auf dem Telefon eine zusammengeschobene Desktopseite',
    stattdessen: 'Eigene mobile Komposition für Hero, Navigation und Anfrage',
  },
];
---

<BaseLayout
  title="Concept Case — das System, einmal gebaut"
  description="Eine vollständig gebaute Concept Study: Positionierung, Auftritt, regionale Sichtbarkeit und Anfrageweg an einem Dachdecker-Beispielbetrieb durchgezogen."
  path="/demo"
>
  <SeitenKopf
    marke="Concept Case"
    zeilen={['Das System,', 'einmal vollständig', 'durchgezogen.']}
    text="Eine Concept Study statt einer Referenzliste: der komplette Auftritt eines Dachdeckerbetriebs, gebaut wie für einen Kunden — Positionierung, Seitenaufbau, Anfragestrecke. Jede Entscheidung darin ist echt getroffen; der Betrieb dahinter ist frei angelegt und kein Kunde."
  />

  <ConceptCase kompakt={true} />

  <!-- Stationen mit ausführlicher Begründung -->
  <section class="kapitel schnitt bg-papier" aria-labelledby="stationen-titel">
    <div class="schiene">
      <div class="grid gap-x-8 gap-y-8 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <Marke label="Die Entscheidungen" />
          <h2 id="stationen-titel" class="mt-8 max-w-[17ch] text-gross lg:mt-10">
            Sechs Stellen, an denen sich eine Anfrage entscheidet.
          </h2>
        </div>
      </div>

      <ol class="mt-12 border-t border-schiefer lg:mt-16">
        {
          demoStationen.map((station, i) => (
            <li class="border-b border-linie-stark py-10 lg:py-16">
              <div class="grid gap-x-8 gap-y-8 lg:grid-cols-12">
                <div class="steig lg:col-span-4">
                  <span class="marke zahlen">{station.nr}</span>
                  <h3 class="mt-3 text-[clamp(1.6rem,2.6vw,2.3rem)] font-medium tracking-[-0.03em]">
                    {station.titel}
                  </h3>
                  <p class="vorspann mt-5 max-w-[34ch]">{station.kurz}</p>
                  <p class="fliess mt-4 max-w-[38ch] text-klein">{station.text}</p>
                </div>

                <div class="lg:col-span-7 lg:col-start-6">
                  <figure class="bildmaske border border-linie-stark bg-kalkstein">
                    <img
                      src={station.bild}
                      width="1100"
                      height="640"
                      alt={`Ausschnitt der Dachdecker-Demo: ${station.titel}`}
                      class="w-full"
                      loading={i < 2 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  </figure>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Verbreitete Muster gegenübergestellt -->
  <section class="kapitel schnitt stein" aria-labelledby="muster-titel">
    <div class="schiene">
      <div class="grid gap-x-8 gap-y-8 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <Marke label="Muster" />
          <h2 id="muster-titel" class="mt-8 max-w-[18ch] text-gross lg:mt-10">
            Was viele Handwerksseiten tun — und was stattdessen trägt.
          </h2>
        </div>
        <div class="lg:col-span-4 lg:col-start-9 lg:self-end">
          <p class="steig fliess text-klein" style="--i:1">
            Ohne fremde Website als Negativbeispiel: Die Muster links stehen für sich, sie
            gehören keinem Betrieb. Was rechts steht, ist die Regel, nach der wir bauen.
          </p>
        </div>
      </div>

      <div class="mt-12 border-t border-schiefer lg:mt-16">
        {
          muster.map((m, i) => (
            <div
              class="steig grid gap-x-12 gap-y-3 border-b border-linie-stark py-6 md:grid-cols-2"
              style={`--i:${Math.min(i, 4)}`}
            >
              <p class="flex gap-4 text-klein text-graphit">
                <span class="mt-[0.7em] h-px w-5 shrink-0 bg-zinnober" aria-hidden="true" />
                <span>{m.verbreitet}</span>
              </p>
              <p class="flex gap-4 text-klein text-schiefer">
                <span class="mt-[0.7em] h-px w-5 shrink-0 bg-moos" aria-hidden="true" />
                <span>{m.stattdessen}</span>
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Übertragung auf den eigenen Betrieb -->
  <section class="kapitel schnitt bg-papier" aria-labelledby="uebertragung-titel">
    <div class="schiene">
      <div class="grid gap-x-8 gap-y-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <Marke label="Für Ihren Betrieb" />
          <h2 id="uebertragung-titel" class="mt-8 max-w-[14ch] text-gross lg:mt-10">
            So würden wir es für Sie anpassen.
          </h2>
        </div>

        <div class="lg:col-span-6 lg:col-start-7">
          <p class="steig vorspann max-w-[46ch]" style="--i:1">
            Die Demo ist kein Vorlagensatz, den wir Ihnen mit ausgetauschtem Logo verkaufen.
            Sie zeigt ein Qualitätsniveau und eine Denkweise — der konkrete Aufbau ergibt
            sich aus Ihrem Aufmaß.
          </p>
          <p class="steig fliess mt-6 max-w-[52ch]" style="--i:2">
            Ein Betrieb, der überwiegend Flachdächer für Gewerbekunden macht, bekommt eine
            andere Startseite als einer, der von privaten Steildachsanierungen lebt. Die
            Fotografie kommt von Ihren eigenen Baustellen, nicht aus einer Bilddatenbank.
            Und die Leistungen, die nach vorn kommen, sind die mit der besten Marge in Ihrem
            Gebiet — nicht die, die am häufigsten angefragt werden.
          </p>

          <div class="steig mt-10" style="--i:3">
            <a
              href={site.demoUrl}
              target="_blank"
              rel="noopener"
              data-ereignis="demo_open"
              class="knopf"
            >
              Live-Demo ansehen
              <svg viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5" aria-hidden="true">
                <path
                  d="M7 17 17 7M9 7h8v8"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="square"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <AbschlussCTA
    zeilen={['Soll Ihr Auftritt', 'so aussehen?']}
    text="In der Potenzialanalyse sehen wir uns an, welche Leistungen bei Ihnen nach vorn gehören und was ein solcher Auftritt in Ihrem Einzugsgebiet bewirken kann."
  />
</BaseLayout>
