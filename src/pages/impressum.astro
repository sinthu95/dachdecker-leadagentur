---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeitenKopf from '../components/SeitenKopf.astro';
import Luecke from '../components/Luecke.astro';
import { site, impressum, impressumVollstaendig } from '../config/site';

/**
 * Pflichtangaben nach § 5 DDG. Es wird nichts erfunden: Alles, was noch nicht
 * vorliegt, erscheint als markierte Lücke. Solange auch nur eine Angabe fehlt,
 * bleibt die Seite auf noindex — ein unvollständiges Impressum ist abmahnfähig.
 */
---

<BaseLayout
  title="Impressum"
  description="Impressum und Anbieterkennzeichnung von S&S Leadcraft."
  path="/impressum"
  noindex={!impressumVollstaendig}
>
  <SeitenKopf marke="Rechtliches" titel="Impressum" />

  <section class="abschnitt bg-schiefer">
    <div class="shell">
      {
        !impressumVollstaendig && (
          <div class="mb-14 max-w-3xl border-l-2 border-rotstift-hell bg-rotstift/10 px-6 py-5">
            <p class="font-mono text-[0.62rem] tracking-[0.16em] text-rotstift-hell uppercase">
              Noch nicht vollständig
            </p>
            <p class="mt-3 text-klein text-kalk">
              Dieses Impressum enthält noch nicht alle Pflichtangaben nach § 5 DDG. Die
              fehlenden Angaben sind unten markiert und werden vor dem Livegang ergänzt.
              Bis dahin ist diese Seite für Suchmaschinen gesperrt, und die Website ist
              nicht öffentlich beworben.
            </p>
          </div>
        )
      }

      <div class="grid gap-y-14 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-8 xl:col-span-7">
          <h2 class="text-statement">Anbieter</h2>
          <dl class="mt-7 border-t border-linie">
            <div class="grid gap-2 border-b border-linie py-4 sm:grid-cols-3">
              <dt class="font-mono text-[0.62rem] tracking-[0.16em] text-zink uppercase">
                Name
              </dt>
              <dd class="sm:col-span-2">{impressum.anbieter}</dd>
            </div>
            <div class="grid gap-2 border-b border-linie py-4 sm:grid-cols-3">
              <dt class="font-mono text-[0.62rem] tracking-[0.16em] text-zink uppercase">
                Rechtsform
              </dt>
              <dd class="sm:col-span-2">
                {impressum.rechtsform ?? <Luecke was="Rechtsform" />}
              </dd>
            </div>
            <div class="grid gap-2 border-b border-linie py-4 sm:grid-cols-3">
              <dt class="font-mono text-[0.62rem] tracking-[0.16em] text-zink uppercase">
                Anschrift
              </dt>
              <dd class="sm:col-span-2">
                {
                  impressum.strasse && impressum.plzOrt ? (
                    <>
                      {impressum.strasse}
                      <br />
                      {impressum.plzOrt}
                      <br />
                      {site.land}
                    </>
                  ) : (
                    <Luecke was="Ladungsfähige Anschrift" />
                  )
                }
              </dd>
            </div>
            <div class="grid gap-2 border-b border-linie py-4 sm:grid-cols-3">
              <dt class="font-mono text-[0.62rem] tracking-[0.16em] text-zink uppercase">
                Telefon
              </dt>
              <dd class="sm:col-span-2">
                <a href={`tel:${site.telefon}`} class="tipp underline underline-offset-4"
                  >{site.telefonAnzeige}</a
                >
              </dd>
            </div>
            <div class="grid gap-2 border-b border-linie py-4 sm:grid-cols-3">
              <dt class="font-mono text-[0.62rem] tracking-[0.16em] text-zink uppercase">
                E-Mail
              </dt>
              <dd class="sm:col-span-2">
                {
                  site.contactEmail ? (
                    <a href={`mailto:${site.contactEmail}`} class="underline underline-offset-4">
                      {site.contactEmail}
                    </a>
                  ) : (
                    <Luecke was="E-Mail-Adresse" />
                  )
                }
              </dd>
            </div>
            <div class="grid gap-2 border-b border-linie py-4 sm:grid-cols-3">
              <dt class="font-mono text-[0.62rem] tracking-[0.16em] text-zink uppercase">
                Umsatzsteuer
              </dt>
              <dd class="sm:col-span-2">
                {
                  impressum.umsatzsteuerId ??
                    (impressum.kleinunternehmer === true ? (
                      'Kleinunternehmer nach § 19 UStG — es wird keine Umsatzsteuer ausgewiesen.'
                    ) : (
                      <Luecke was="USt-IdNr. oder Kleinunternehmerhinweis" />
                    ))
                }
              </dd>
            </div>
            <div class="grid gap-2 border-b border-linie py-4 sm:grid-cols-3">
              <dt class="font-mono text-[0.62rem] tracking-[0.16em] text-zink uppercase">
                Register
              </dt>
              <dd class="sm:col-span-2">
                {impressum.register ?? <Luecke was="Registereintrag, falls zutreffend" />}
              </dd>
            </div>
            <div class="grid gap-2 border-b border-linie py-4 sm:grid-cols-3">
              <dt class="font-mono text-[0.62rem] tracking-[0.16em] text-zink uppercase">
                Verantwortlich für den Inhalt
              </dt>
              <dd class="sm:col-span-2">
                {
                  impressum.strasse && impressum.plzOrt ? (
                    `${impressum.anbieter}, ${impressum.strasse}, ${impressum.plzOrt}`
                  ) : (
                    <Luecke was="Anschrift des Inhaltsverantwortlichen" />
                  )
                }
              </dd>
            </div>
          </dl>
        </div>

        <div class="lg:col-span-4 xl:col-start-9">
          <h2 class="text-statement">Hinweise</h2>

          <div class="mt-7 space-y-8 text-klein text-zink">
            <div>
              <h3 class="font-semibold text-kalk">Streitbeilegung</h3>
              <p class="mt-2">
                Wir sind nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren
                vor einer Verbraucherschlichtungsstelle teilzunehmen.
              </p>
            </div>

            <div>
              <h3 class="font-semibold text-kalk">Haftung für Inhalte</h3>
              <p class="mt-2">
                Als Diensteanbieter sind wir für eigene Inhalte auf diesen Seiten nach den
                allgemeinen Gesetzen verantwortlich. Wir sind jedoch nicht verpflichtet,
                übermittelte oder gespeicherte fremde Informationen zu überwachen oder nach
                Umständen zu forschen, die auf eine rechtswidrige Tätigkeit hinweisen.
              </p>
            </div>

            <div>
              <h3 class="font-semibold text-kalk">Haftung für Links</h3>
              <p class="mt-2">
                Unser Angebot enthält Links zu externen Websites Dritter, auf deren Inhalte
                wir keinen Einfluss haben. Für die Inhalte der verlinkten Seiten ist stets
                der jeweilige Anbieter verantwortlich. Zum Zeitpunkt der Verlinkung waren
                keine Rechtsverstöße erkennbar.
              </p>
            </div>

            <div>
              <h3 class="font-semibold text-kalk">Urheberrecht</h3>
              <p class="mt-2">
                Die durch uns erstellten Inhalte und Werke auf diesen Seiten unterliegen
                dem deutschen Urheberrecht. Beiträge Dritter sind als solche
                gekennzeichnet.
              </p>
            </div>

            <div>
              <h3 class="font-semibold text-kalk">Demonstrationsprojekt</h3>
              <p class="mt-2">
                Der auf dieser Website gezeigte Concept Case („Musterdach GmbH") ist ein
                frei erfundenes Demonstrationsprojekt. Es besteht keine Geschäftsbeziehung
                zu einem realen Betrieb dieses Namens; sämtliche dort gezeigten Angaben
                sind Beispielinhalte.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
