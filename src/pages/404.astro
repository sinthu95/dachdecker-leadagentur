---
import BaseLayout from '../layouts/BaseLayout.astro';
import Linie from '../components/Linie.astro';
import { navigation } from '../data/inhalte';
import { site } from '../config/site';
---

<BaseLayout
  title="Seite nicht gefunden"
  description="Diese Seite existiert nicht."
  path="/404"
  noindex={true}
>
  <section class="relative flex min-h-[80svh] items-center overflow-hidden bg-papier pt-32 pb-20">
    <div class="schiene relative w-full">
      <div
        class="steig flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1 border-b border-linie pb-3"
      >
        <span class="marke">Nicht gefunden</span>
        <span class="marke zahlen">404</span>
      </div>

      <div class="mt-10 grid items-end gap-8 lg:mt-14 lg:grid-cols-12">
        <h1 class="zeilen max-w-[14ch] text-gross lg:col-span-9">
          <span class="zeile"><span style="--i:0">Diese Seite</span></span>
          <span class="zeile"><span style="--i:1">gibt es nicht.</span></span>
        </h1>
        <div class="hidden lg:col-span-3 lg:block" aria-hidden="true">
          <Linie art="dach" class="h-24 w-full text-schiefer opacity-40" />
        </div>
      </div>

      <p class="steig vorspann mt-10 max-w-[44ch]" style="--i:1">
        Entweder hat sich ein Tippfehler in die Adresse geschlichen oder die Seite wurde
        umbenannt. Hier kommen Sie weiter:
      </p>

      <nav aria-label="Weiterführende Seiten" class="mt-12 max-w-2xl border-t border-schiefer">
        {
          navigation.map((eintrag, i) => (
            <a
              href={eintrag.href}
              class="steig tipp flex items-center justify-between gap-6 border-b border-linie-stark py-4 transition-opacity duration-500 hover:opacity-60"
              style={`--i:${Math.min(i, 4)}`}
            >
              <span class="text-[1.1rem] tracking-[-0.02em]">{eintrag.label}</span>
              <svg viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5" aria-hidden="true">
                <path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" />
              </svg>
            </a>
          ))
        }
      </nav>

      <p class="steig fliess mt-8 text-klein">
        Oder direkt anrufen: <a href={`tel:${site.telefon}`} data-ereignis="call_click"
          >{site.telefonAnzeige}</a
        >
      </p>
    </div>
  </section>
</BaseLayout>
