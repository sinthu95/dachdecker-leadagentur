---
import BaseLayout from '../layouts/BaseLayout.astro';
import Linie from '../components/Linie.astro';
import Marke from '../components/Marke.astro';
import { site } from '../config/site';

/** Ziel der Conversion-Messung. Nie im Index. */
const schritte = [
  {
    nr: '01',
    titel: 'Wir sehen uns Ihr Gebiet an',
    text: 'Vor dem Gespräch prüfen wir Wettbewerb, Suchvolumen und Ihren jetzigen Auftritt. Damit müssen Sie uns nicht erst erklären, wie Ihr Markt aussieht.',
  },
  {
    nr: '02',
    titel: 'Wir melden uns innerhalb eines Werktags',
    text: 'Telefonisch, zur angegebenen Zeit. Wenn wir Sie nicht erreichen, versuchen wir es erneut — und schreiben Ihnen.',
  },
  {
    nr: '03',
    titel: 'Sie bekommen eine ehrliche Einschätzung',
    text: 'Rund 40 Minuten. Am Ende wissen Sie, was in Ihrem Einzugsgebiet realistisch ist — auch wenn die Antwort lautet, dass sich der Aufwand für Sie nicht lohnt.',
  },
];
---

<BaseLayout
  title="Anfrage eingegangen"
  description="Ihre Anfrage für eine Potenzialanalyse ist eingegangen."
  path="/danke"
  noindex={true}
>
  <section class="relative overflow-hidden bg-papier pt-32 pb-16 lg:pt-44 lg:pb-24">
    <div class="schiene relative">
      <div
        class="steig flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1 border-b border-linie pb-3"
      >
        <span class="marke">Eingegangen</span>
        <span class="marke zahlen">38°</span>
      </div>

      <div class="mt-10 grid items-end gap-8 lg:mt-14 lg:grid-cols-12">
        <h1 class="zeilen max-w-[16ch] text-gross lg:col-span-9">
          <span class="zeile"><span style="--i:0">Danke. Ihre Anfrage</span></span>
          <span class="zeile"><span style="--i:1">ist angekommen.</span></span>
        </h1>
        <div class="hidden lg:col-span-3 lg:block" aria-hidden="true">
          <Linie art="dach" class="h-24 w-full text-schiefer opacity-40" />
        </div>
      </div>

      <p class="steig vorspann mt-10 max-w-[44ch]" style="--i:1">
        {site.antwortzeit} Bis dahin müssen Sie nichts weiter tun.
      </p>
    </div>
  </section>

  <section class="kapitel-eng schnitt stein" aria-labelledby="ablauf-titel">
    <div class="schiene">
      <Marke label="Was jetzt passiert" />
      <h2 id="ablauf-titel" class="sr-only">Was jetzt passiert</h2>

      <ol class="mt-12 border-t border-schiefer">
        {
          schritte.map((s, i) => (
            <li
              class="steig grid gap-x-8 gap-y-2 border-b border-linie-stark py-7 lg:grid-cols-12"
              style={`--i:${i}`}
            >
              <span class="marke zahlen lg:col-span-1">{s.nr}</span>
              <h3 class="text-[1.2rem] font-medium tracking-[-0.025em] lg:col-span-4">
                {s.titel}
              </h3>
              <p class="fliess max-w-[56ch] text-klein lg:col-span-6 lg:col-start-7">{s.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-16 grid gap-x-8 gap-y-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h2 class="text-mittel max-w-[20ch]">Solange können Sie sich das hier ansehen.</h2>
          <p class="steig fliess mt-5 max-w-[50ch] text-klein" style="--i:1">
            Der Concept Case zeigt an einem vollständig gebauten Auftritt, wie wir arbeiten
            und warum wir welche Entscheidung treffen.
          </p>
          <div class="steig mt-8 flex flex-col gap-4 sm:flex-row" style="--i:2">
            <a href="/demo" class="knopf w-full sm:w-auto">Concept Case ansehen</a>
            <a href="/leistungen" class="knopf knopf-linie w-full sm:w-auto">Das System</a>
          </div>
        </div>

        <div class="lg:col-span-4 lg:col-start-9">
          <p class="marke">Dringend?</p>
          <p class="steig mt-3" style="--i:1">
            <a href={`tel:${site.telefon}`} data-ereignis="call_click" class="verweis text-[1.15rem]">
              {site.telefonAnzeige}
            </a>
          </p>
          <p class="steig fliess mt-2 text-klein" style="--i:2">{site.erreichbarkeit}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
