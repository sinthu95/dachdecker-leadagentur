---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeitenKopf from '../components/SeitenKopf.astro';
import System from '../components/System.astro';
import LeistungsIndex from '../components/LeistungsIndex.astro';
import Prozess from '../components/Prozess.astro';
import Fragen from '../components/Fragen.astro';
import AbschlussCTA from '../components/AbschlussCTA.astro';
import Marke from '../components/Marke.astro';
import { stufen } from '../data/inhalte';
import { site } from '../config/site';

/** Preise werden nicht genannt — aber die Struktur wird erklärt. */
const kosten = [
  {
    was: 'Potenzialanalyse',
    wie: 'kostenfrei',
    text: 'Rund 40 Minuten. Sie bekommen eine Einschätzung zu Ihrem Einzugsgebiet — unabhängig davon, ob wir danach zusammenarbeiten.',
  },
  {
    was: 'Aufmaß und Aufbau',
    wie: 'einmaliges Honorar',
    text: 'Die Höhe hängt vom Umfang ab, der sich aus der Analyse ergibt: eine Landingpage ist etwas anderes als ein vollständiger Auftritt.',
  },
  {
    was: 'Auslastung',
    wie: 'monatliche Betreuung',
    text: 'Laufende Kampagnen, Auswertung und Optimierung. Getrennt vom Werbebudget abgerechnet.',
  },
  {
    was: 'Werbebudget',
    wie: 'direkt an Google und Meta',
    text: 'Über Ihre eigenen Konten. Wir fassen es nicht an und verdienen nicht daran mit — das schließt einen Interessenkonflikt aus.',
  },
];
---

<BaseLayout
  title="Das System"
  description="Das Dachdecker-Auftragssystem von S&S Leadcraft: Aufmaß, Aufbau, Auslastung. Website, Google Ads, Meta Ads, Tracking und Optimierung als ein Ablauf."
  path="/leistungen"
>
  <SeitenKopf
    marke="Das System"
    zeilen={['Zwölf Leistungen', 'ergeben noch', 'kein System.']}
    text={`Wir verkaufen keinen Leistungskatalog, sondern einen Ablauf, in dem jedes Bauteil eine Aufgabe hat und einzeln überprüfbar ist. Intern heißt er ${site.angebot}.`}
  />

  <System ausfuehrlich={true} />

  <!-- Die drei Stufen ausführlich: Aufmaß, Aufbau, Auslastung -->
  <section class="kapitel schnitt bg-papier" aria-labelledby="stufen-titel">
    <div class="schiene">
      <Marke label="Die drei Stufen" />
      <h2 id="stufen-titel" class="mt-8 max-w-[16ch] text-gross lg:mt-10">
        Aufmaß. Aufbau. Auslastung.
      </h2>
      <p class="steig vorspann mt-8 max-w-[44ch]" style="--i:1">
        Die Namen stammen aus Ihrer Sprache — die dritte ist zugleich Ihr Geschäftsziel.
      </p>

      <div class="mt-12 space-y-0 border-t border-schiefer lg:mt-16">
        {
          stufen.map((stufe, i) => (
            <div class="steig border-b border-linie-stark py-10 lg:py-14" style={`--i:${i}`}>
              <div class="grid gap-x-8 gap-y-6 lg:grid-cols-12">
                <div class="lg:col-span-3">
                  <span class="marke zahlen">{stufe.nr}</span>
                  <h3 class="mt-3 text-[clamp(1.8rem,3vw,2.6rem)] font-medium tracking-[-0.035em]">
                    {stufe.name}
                  </h3>
                  <p class="marke mt-3">{stufe.zeit}</p>
                </div>

                <div class="lg:col-span-4">
                  <p class="vorspann">{stufe.satz}</p>
                  <p class="fliess mt-4 max-w-[42ch] text-klein">{stufe.text}</p>
                </div>

                <div class="lg:col-span-4 lg:col-start-9">
                  <ul class="border-t border-linie">
                    {stufe.punkte.map((punkt) => (
                      <li class="border-b border-linie py-2.5 text-[0.92rem] text-graphit">
                        {punkt}
                      </li>
                    ))}
                  </ul>
                  <p class="mt-5 flex gap-3 text-[0.92rem] text-schiefer">
                    <span class="mt-[0.6em] h-px w-4 shrink-0 bg-schiefer" aria-hidden="true" />
                    {stufe.ergebnis}
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <LeistungsIndex />
  <Prozess />

  <!-- Kostenstruktur ohne erfundene Zahlen -->
  <section class="kapitel schnitt stein" aria-labelledby="kosten-titel">
    <div class="schiene">
      <div class="grid gap-x-8 gap-y-8 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <Marke label="Was es kostet" />
          <h2 id="kosten-titel" class="mt-8 max-w-[18ch] text-gross lg:mt-10">
            Keine Zahl. Aber die Struktur.
          </h2>
        </div>
        <div class="lg:col-span-4 lg:col-start-9 lg:self-end">
          <p class="steig vorspann" style="--i:1">
            Ein Preisschild auf dieser Seite wäre für Ihren Betrieb mit hoher
            Wahrscheinlichkeit falsch. Was wir stattdessen offenlegen, ist, wie sich die
            Kosten zusammensetzen.
          </p>
        </div>
      </div>

      <div class="mt-12 border-t border-schiefer lg:mt-16">
        {
          kosten.map((posten, i) => (
            <div
              class="steig grid gap-x-8 gap-y-2 border-b border-linie-stark py-7 lg:grid-cols-12"
              style={`--i:${i}`}
            >
              <p class="text-[1.15rem] font-medium tracking-[-0.02em] lg:col-span-3">
                {posten.was}
              </p>
              <p class="marke lg:col-span-3">{posten.wie}</p>
              <p class="fliess max-w-[52ch] lg:col-span-5 lg:col-start-8">{posten.text}</p>
            </div>
          ))
        }
      </div>

      <p class="steig fliess mt-10 max-w-[56ch] text-klein">
        Ein Grundsatz vorab: Website, Domain, Werbekonten und Tracking laufen auf Ihren
        Namen. Wenn wir uns trennen, bleibt das System bei Ihnen — ohne dass Sie etwas
        herauskaufen müssen.
      </p>
    </div>
  </section>

  <Fragen />
  <AbschlussCTA />
</BaseLayout>
