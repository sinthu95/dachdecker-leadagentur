---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Orientierung from '../components/Orientierung.astro';
import Problem from '../components/Problem.astro';
import ConceptCase from '../components/ConceptCase.astro';
import System from '../components/System.astro';
import Anfrage from '../components/Anfrage.astro';
import Marke from '../components/Marke.astro';
import { wettbewerb } from '../data/inhalte';
import { brancheHolen, BRANCHEN_PFAD } from '../data/branchen';
import { site } from '../config/site';

/**
 * Die erste Branchenseite — und weiterhin die Landingpage für bezahlten
 * Traffic: reduzierte Kopfzeile, kein Menü, ein Ziel. Wer hier ankommt, hat
 * bereits gesucht und braucht Bestätigung, keine Spannung.
 *
 * Was Phase 3 geändert hat und was ausdrücklich nicht
 * ---------------------------------------------------
 *   - Die Adresse bleibt `/dachdecker`. Keine Umleitung, kein neuer Pfad,
 *     keine geänderte kanonische Adresse: Was an Sichtbarkeit auf dieser
 *     Seite liegt, bleibt darauf liegen.
 *   - Titel, Beschreibung und alle branchenspezifischen Texte kommen jetzt aus
 *     `src/data/branchen.ts` statt aus dieser Datei und den Komponenten. Der
 *     Wortlaut ist bis auf zwei Stellen derselbe.
 *   - Die Beschreibung ist gekürzt (war 175 Zeichen, damit über der Grenze,
 *     ab der Google abschneidet) und trägt nicht mehr „ein Betrieb je
 *     Einzugsgebiet". Diese Zusage gilt nicht allgemein, sondern wird einzeln
 *     vereinbart; sie stand zuletzt nur noch hier.
 *   - Neu ist der Abschnitt „Das Problem", der das Motiv B-03 trägt. Es steht
 *     seit Phase 3 nicht mehr auf der branchenoffenen Startseite und hat hier
 *     seinen sachlich richtigen Platz.
 *   - Unverändert bleiben Aufbau, Reihenfolge und das eine Ziel der Seite:
 *     die Anfrage am Ende.
 */
const branche = brancheHolen('dachdecker')!;
---

<BaseLayout
  title={branche.seo.titel}
  description={branche.seo.beschreibung}
  path={branche.pfad}
  fokus={true}
>
  <Hero branche="dachdecker" />
  <Orientierung />
  <Problem branche="dachdecker" />

  <!-- Der schärfste Einwand zuerst: geteilte Portal-Leads -->
  <section class="kapitel schnitt stein" aria-labelledby="portale-titel">
    <div class="schiene">
      <div class="grid gap-x-8 gap-y-8 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <Marke label="Der Unterschied" />
          <h2 id="portale-titel" class="mt-8 max-w-[16ch] text-gross lg:mt-10">
            Ihre Anfragen. Nicht der vierte Anruf beim selben Kunden.
          </h2>
        </div>

        <div class="lg:col-span-4 lg:col-start-9 lg:self-end">
          <p class="steig vorspann" style="--i:1">
            Wer Anfragen über Portale kauft, kauft sie geteilt: Derselbe Interessent hat in
            der Regel schon mit drei weiteren Betrieben gesprochen, bevor Sie ihn erreichen.
            Eine Anfrage über Ihre eigene Seite kommt nur bei Ihnen an.
          </p>
        </div>
      </div>

      <div class="mt-12 border-t border-schiefer lg:mt-16">
        {
          wettbewerb.map((zeile, i) => (
            <div
              class="steig grid gap-x-8 gap-y-3 border-b border-linie-stark py-7 md:grid-cols-12"
              style={`--i:${Math.min(i, 4)}`}
            >
              <div class="md:col-span-3">
                <p class="text-[1.12rem] font-medium tracking-[-0.02em]">{zeile.was}</p>
                {zeile.zusatz && <p class="marke mt-1.5">{zeile.zusatz}</p>}
              </div>
              <p class="fliess text-klein italic md:col-span-4">„{zeile.denkt}"</p>
              <p class="fliess max-w-[46ch] text-klein md:col-span-5">{zeile.antwort}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <ConceptCase branche="dachdecker" />
  <System branche="dachdecker" />
  <Anfrage />

  {/* Einordnung statt Sackgasse.

      Die Seite läuft bewusst ohne Menü — ein Ziel, keine Abzweigungen. Seit
      sie von `/branchen` aus verlinkt ist, kommen hier aber auch Leser an, die
      nicht auf eine Anzeige geklickt haben; für sie endete die Seite bisher
      ohne jeden Weg zurück. Diese eine schmale Zeile steht deshalb hinter dem
      Formular, nicht davor: Wer bis hierher gelesen hat, ist an der Anfrage
      vorbei und verliert nichts mehr. */}
  {/* Eigene Beschriftung, nicht „Einordnung": Diesen Namen trägt bereits der
      Orientierungsblock unter dem Hero. Zwei Bereiche mit derselben
      Beschriftung sind für einen Screenreader nicht unterscheidbar. */}
  <section class="stein" aria-label="Zuordnung dieser Seite">
    <div class="schiene">
      <div
        class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 border-t border-linie py-5"
      >
        <p class="marke">
          Branchenseite {branche.nr} · {branche.name}
        </p>
        <p class="flex flex-wrap gap-x-7 gap-y-2">
          <a href={BRANCHEN_PFAD} class="marke tipp text-schiefer">Alle Branchen</a>
          <a href="/" class="marke tipp text-schiefer">{site.name}</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
