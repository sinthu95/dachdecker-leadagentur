---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeitenKopf from '../components/SeitenKopf.astro';
import Anfrage from '../components/Anfrage.astro';
import Marke from '../components/Marke.astro';
import { site } from '../config/site';
---

<BaseLayout
  title="Potenzialanalyse anfragen"
  description="Fordern Sie eine kostenfreie Potenzialanalyse für Ihren Dachdeckerbetrieb an: rund 40 Minuten, mit einer ehrlichen Einschätzung zu Ihrem Einzugsgebiet."
  path="/kontakt"
>
  <SeitenKopf
    marke="Kontakt"
    zeilen={['Potenzialanalyse', 'anfragen.']}
    text="Kostenfrei, rund 40 Minuten, kein Verkaufsgespräch. Am Ende wissen Sie, ob in Ihrem Einzugsgebiet digital etwas zu holen ist — und wir sagen Ihnen auch, wenn wir nicht die Richtigen sind."
  />

  <!-- Fehlerhinweis nach serverseitiger Ablehnung. Die Seite ist statisch,
       deshalb wird der Hinweis clientseitig anhand der Adresse eingeblendet. -->
  <div class="schiene">
    <div
      id="formularfehler"
      hidden
      role="alert"
      class="mt-10 border-l border-zinnober bg-zinnober/8 px-6 py-5"
    >
      <p class="marke text-zinnober">Anfrage nicht abgeschickt</p>
      <p class="fliess mt-2 max-w-[60ch] text-klein" id="formularfehler-text"></p>
    </div>
  </div>

  <Anfrage knapp={true} />

  <!-- Direkter Weg -->
  <section class="kapitel-eng schnitt stein" aria-labelledby="direkt-titel">
    <div class="schiene">
      <div class="grid gap-x-8 gap-y-8 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <Marke label="Direkt" />
          <h2 id="direkt-titel" class="mt-8 max-w-[12ch] text-mittel lg:mt-10">
            Lieber direkt sprechen?
          </h2>
        </div>

        <div class="lg:col-span-6 lg:col-start-7">
          <dl class="border-t border-schiefer">
            <div class="steig grid gap-x-8 gap-y-1 border-b border-linie-stark py-5 sm:grid-cols-3">
              <dt class="marke sm:pt-[0.35em]">Telefon</dt>
              <dd class="sm:col-span-2">
                <a href={`tel:${site.telefon}`} data-ereignis="call_click" class="verweis text-[1.15rem]">
                  {site.telefonAnzeige}
                </a>
                <p class="fliess mt-1 text-klein">{site.erreichbarkeit}</p>
              </dd>
            </div>

            <div
              class="steig grid gap-x-8 gap-y-1 border-b border-linie-stark py-5 sm:grid-cols-3"
              style="--i:1"
            >
              <dt class="marke sm:pt-[0.35em]">E-Mail</dt>
              {/* Keine erfundene Adresse — der Hinweis nennt den Weg, der wirklich geht. */}
              <dd class="fliess text-klein sm:col-span-2">{site.emailHinweis}</dd>
            </div>

            <div
              class="steig grid gap-x-8 gap-y-1 border-b border-linie-stark py-5 sm:grid-cols-3"
              style="--i:2"
            >
              <dt class="marke sm:pt-[0.35em]">Sitz</dt>
              <dd class="fliess text-klein sm:col-span-2">
                {site.gruender}<br />{site.ort}, {site.land}
                <span class="mt-1 block text-graphit">Wir arbeiten deutschlandweit.</span>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var meldungen = {
      pflichtfelder:
        'Es fehlt noch eine Pflichtangabe: Betrieb, Standort, gewünschte Leistungen, Kapazität, Ansprechpartner, Telefon, E-Mail oder die Einwilligung zum Datenschutz. Ihre Eingaben stehen weiter im Formular.',
      format: 'Die Anfrage konnte technisch nicht gelesen werden. Bitte versuchen Sie es erneut.',
    };
    var art = new URLSearchParams(window.location.search).get('fehler');
    if (!art) return;
    var kasten = document.getElementById('formularfehler');
    var text = document.getElementById('formularfehler-text');
    if (!kasten || !text) return;
    text.textContent = meldungen[art] || meldungen.format;
    kasten.hidden = false;
    kasten.scrollIntoView({ block: 'center' });
  })();
</script>
