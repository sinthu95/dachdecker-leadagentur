---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Orientierung from '../components/Orientierung.astro';
import Problem from '../components/Problem.astro';
import NeueRealitaet from '../components/NeueRealitaet.astro';
import System from '../components/System.astro';
import ConceptCase from '../components/ConceptCase.astro';
import Spezialisierung from '../components/Spezialisierung.astro';
import Prozess from '../components/Prozess.astro';
import AntiVersprechen from '../components/AntiVersprechen.astro';
import Gruender from '../components/Gruender.astro';
import Passung from '../components/Passung.astro';
import Anfrage from '../components/Anfrage.astro';
---

<BaseLayout
  title="Digitale Kundengewinnung für Dachdeckerbetriebe"
  description="Digitale Kundengewinnung ausschließlich für Dachdeckerbetriebe: Website, Google Ads, Meta Ads und Messung als ein System. Ein Betrieb je Einzugsgebiet."
  path="/"
  transparenterHeader={true}
>
  <Hero />
  <Orientierung />
  <Problem />
  <NeueRealitaet />
  <System nr="03" />
  <ConceptCase nr="04" />
  <Spezialisierung nr="05" />
  <Prozess nr="06" />
  <AntiVersprechen nr="07" />
  <Gruender nr="08" />
  <Passung nr="09" />
  <Anfrage nr="10" />
</BaseLayout>
