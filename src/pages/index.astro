---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Orientierung from '../components/Orientierung.astro';
import Problem from '../components/Problem.astro';
import NeueRealitaet from '../components/NeueRealitaet.astro';
import System from '../components/System.astro';
import SchemaAnfrageweg from '../components/SchemaAnfrageweg.astro';
import ConceptCase from '../components/ConceptCase.astro';
import LeistungsIndex from '../components/LeistungsIndex.astro';
import Spezialisierung from '../components/Spezialisierung.astro';
import SchemaGebiet from '../components/SchemaGebiet.astro';
import Bildband from '../components/Bildband.astro';
import Prozess from '../components/Prozess.astro';
import AntiVersprechen from '../components/AntiVersprechen.astro';
import Gruender from '../components/Gruender.astro';
import Passung from '../components/Passung.astro';
import Anfrage from '../components/Anfrage.astro';
import AbschlussCTA from '../components/AbschlussCTA.astro';
---

<BaseLayout
  title="Digitale Kundengewinnung für Unternehmen"
  description="Websites, Google Ads, Meta Ads, Messung und Automatisierung als ein System — für Unternehmen, die planbar qualifizierte Anfragen gewinnen wollen."
  path="/"
>
  <Hero />
  <Orientierung />
  <Problem />
  <NeueRealitaet />
  <System />
  <SchemaAnfrageweg />
  {/*
    Spezialisierung steht seit Phase 3 vor dem Concept Case, nicht mehr
    dahinter. Grund ist die Zuordnung: Der Concept Case ist ein
    Dachdeckerprojekt. Als eigenständiger Abschnitt mitten auf der
    branchenoffenen Startseite las er sich wie der Beweis der Hauptmarke — und
    zog sie damit in ein Gewerk zurück. Jetzt steht zuerst die Behauptung
    („ein System, branchentief angewandt") und direkt darunter ihr Beleg: die
    erste Branche, einmal ganz durchgezogen. Der Abschnitt nennt sie beim
    Namen und verweist auf ihre Seite.
  */}
  <Spezialisierung />
  <ConceptCase branche="dachdecker" />
  <LeistungsIndex />
  <SchemaGebiet />
  <Bildband />
  <Prozess />
  <AntiVersprechen />
  <Gruender />
  <Passung />
  <Anfrage />
  <AbschlussCTA />
</BaseLayout>
