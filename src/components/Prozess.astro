---
import Marke from './Marke.astro';
import { prozess } from '../data/inhalte';

/**
 * Die Signaturlinie wird hier zur senkrechten Konstruktionsachse. Die Schritte
 * hängen daran wie Bauteile an einem Lot — kein Kachelraster, keine Karten.
 */
---

<section class="kapitel schnitt dunkel" aria-labelledby="prozess-titel">
  <div class="schiene">
    <div class="grid gap-x-8 gap-y-8 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <Marke label="Prozess" />
        <h2 id="prozess-titel" class="mt-8 max-w-[20ch] text-gross lg:mt-10">
          Was wann passiert — und was Sie dabei tun müssen.
        </h2>
      </div>
      <div class="lg:col-span-4 lg:col-start-9 lg:self-end">
        <p class="steig vorspann" style="--i:1">
          Die häufigste Sorge im Erstgespräch ist nicht der Preis, sondern der Aufwand.
          Deshalb steht er hier in jeder Zeile.
        </p>
      </div>
    </div>

    <div class="relative mt-12 pl-9 lg:mt-16 lg:pl-16">
      <!-- Senkrechte Achse, an der die Schritte hängen wie Bauteile am Lot -->
      <div
        class="zieh-y absolute top-2 bottom-2 left-0 w-px origin-top bg-papier/35"
        aria-hidden="true"
      >
      </div>

      <ol>
        {
          prozess.map((schritt, i) => (
            <li class="steig relative" style={`--i:${Math.min(i, 4)}`}>
              <div class="grid gap-x-8 gap-y-3 border-b border-linie-dunkel py-8 lg:grid-cols-12 lg:py-10">
                <div class="lg:col-span-2">
                  <span class="marke zahlen">{schritt.nr}</span>
                  <p class="mt-1 font-mono text-[0.62rem] tracking-[0.14em] text-graphit-hell uppercase">
                    {schritt.zeit}
                  </p>
                </div>

                <h3 class="text-[1.5rem] font-medium tracking-[-0.025em] lg:col-span-3 lg:text-[1.7rem]">
                  {schritt.name}
                </h3>

                <p class="fliess max-w-[48ch] lg:col-span-4">{schritt.text}</p>

                <div class="lg:col-span-3">
                  <p class="marke">Ihr Aufwand</p>
                  <p class="mt-1.5 text-klein text-papier">{schritt.ihrAufwand}</p>
                </div>
              </div>

              {/* Knotenpunkt auf der Achse */}
              <span
                class="steig absolute top-[2.7rem] left-[calc(-2.25rem-3.5px)] h-[7px] w-[7px] bg-papier lg:top-[3.4rem] lg:left-[calc(-4rem-3.5px)]"
                style={`--i:${Math.min(i, 4)}`}
                aria-hidden="true"
              />
            </li>
          ))
        }
      </ol>
    </div>

    <p class="steig mt-12 max-w-[54ch] text-klein text-graphit-hell">
      Der letzte Punkt ist keine Höflichkeitsfloskel: Ihre kurze Rückmeldung, ob eine
      Anfrage brauchbar war, ist die wichtigste Steuerungsgröße im laufenden Betrieb.
    </p>
  </div>
</section>
