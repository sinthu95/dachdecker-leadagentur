---
import Wortmarke from './Wortmarke.astro';
import { navigation } from '../data/inhalte';
import { site } from '../config/site';

interface Props {
  fokus?: boolean;
}
const { fokus = false } = Astro.props;
const jahr = new Date().getFullYear();
---

<footer class="dunkel pb-28 md:pb-0">
  <div class="schiene border-t border-linie-dunkel pt-10 pb-10 lg:pt-12 lg:pb-12">
    <!-- Große Wortmarke als Schlusszeile, wie das Kolophon einer Publikation.
         Die Haarlinie darüber setzt die Kante fort, auf die der Abschluss-CTA
         zuläuft — die Seite endet nicht, sie schließt. -->
    <div class="border-b border-linie-dunkel pb-10 lg:pb-14">
      <Wortmarke class="text-[clamp(1.6rem,4.5vw,3.2rem)] text-papier" />
    </div>

    <div class="grid gap-y-10 pt-10 lg:grid-cols-12 lg:gap-8 lg:pt-14">
      <div class="lg:col-span-4">
        <p class="max-w-[30ch] text-klein text-papier-gedimmt">
          Digitale Kundengewinnung ausschließlich für Dachdeckerbetriebe.
          Ein Betrieb je Einzugsgebiet.
        </p>
      </div>

      <div class="lg:col-span-3">
        <p class="marke">Kontakt</p>
        <ul class="mt-5 space-y-0.5 text-klein text-papier-gedimmt">
          <li class="text-papier">{site.gruender}</li>
          <li>{site.ort}, {site.land}</li>
          <li>
            <a
              href={`tel:${site.telefon}`}
              data-ereignis="call_click"
              class="tipp text-papier transition-opacity duration-500 hover:opacity-60"
              >{site.telefonAnzeige}</a
            >
          </li>
          {
            site.contactEmail && (
              <li>
                <a
                  href={`mailto:${site.contactEmail}`}
                  class="tipp text-papier transition-opacity duration-500 hover:opacity-60"
                >
                  {site.contactEmail}
                </a>
              </li>
            )
          }
          <li>{site.erreichbarkeit}</li>
        </ul>
        {
          !site.contactEmail && (
            <p class="mt-4 max-w-[30ch] text-[0.8rem] leading-relaxed text-graphit-hell">
              {site.emailHinweis}
            </p>
          )
        }
      </div>

      {
        !fokus && (
          <nav aria-label="Fußnavigation" class="lg:col-span-2">
            <p class="marke">Seiten</p>
            <ul class="mt-5 space-y-0.5 text-klein">
              {navigation.map((eintrag) => (
                <li>
                  <a
                    href={eintrag.href}
                    class="tipp text-papier-gedimmt transition-colors duration-500 hover:text-papier"
                  >
                    {eintrag.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <div class:list={[fokus ? 'lg:col-span-5' : 'lg:col-span-3']}>
        <p class="marke">Rechtliches</p>
        <ul class="mt-5 space-y-0.5 text-klein">
          <li>
            <a
              href="/impressum"
              class="tipp text-papier-gedimmt transition-colors duration-500 hover:text-papier"
              >Impressum</a
            >
          </li>
          <li>
            <a
              href="/datenschutz"
              class="tipp text-papier-gedimmt transition-colors duration-500 hover:text-papier"
              >Datenschutz</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-2 border-t border-linie-dunkel pt-6 font-mono text-[0.62rem] tracking-[0.14em] text-graphit-hell uppercase sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="zahlen">© {jahr} {site.name} · {site.gruender}</p>
      <p>Alle Winkel dieser Seite: 38° — die Regeldachneigung eines Ziegeldachs.</p>
    </div>
  </div>
</footer>
