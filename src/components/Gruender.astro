---
import Marke from './Marke.astro';
import Bildfeld from './Bildfeld.astro';
import { site } from '../config/site';

interface Props {
  ausfuehrlich?: boolean;
}
const { ausfuehrlich = false } = Astro.props;
---

<section class="kapitel schnitt bg-papier" aria-labelledby="gruender-titel">
  <div class="schiene">
    <div class="grid gap-x-8 gap-y-12 lg:grid-cols-12">
      <!-- Das Porträt trägt den Abschnitt. Kein Stockfoto, keine Platzhalterperson. -->
      <div class="bildmaske versatz lg:col-span-5" data-versatz="14">
        <Bildfeld
          nummer="B-06"
          motiv="Porträt Sinthusan Sinnathurai — halbnah, ruhiger Hintergrund, natürliches Seitenlicht. Kein Anzug vor Glasfassade."
          ausschnitt="Hochformat, Blick zur Kamera"
          format="4/5"
          class="h-full w-full"
        />
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <Marke label="Wer dahintersteht" />

        <h2 id="gruender-titel" class="mt-8 text-gross lg:mt-10">
          {site.gruender}
        </h2>
        <p class="steig marke mt-4" style="--i:1">Gründer · {site.ort}</p>

        <div class="mt-10 space-y-6">
          <p class="steig vorspann max-w-[44ch]" style="--i:2">
            Es gibt sehr viele Handwerksbetriebe, die ihre Arbeit ausgezeichnet machen und
            trotzdem online kaum stattfinden — während Portale und größere Anbieter genau
            die Anfragen abgreifen, die diesen Betrieben zustehen würden.
          </p>
          <p class="steig fliess max-w-[48ch]" style="--i:3">
            Statt das für zwanzig Branchen halb zu lösen, habe ich mich für eine
            entschieden. Dachdeckerbetriebe arbeiten mit hohen Auftragswerten, klaren
            Leistungsgrenzen und einem Einzugsgebiet, das man sauber abstecken kann. Das
            ist eine Branche, in der ein durchdachtes digitales System einen messbaren
            Unterschied macht.
          </p>
          <p class="steig fliess max-w-[48ch]" style="--i:4">
            Ich verspreche Ihnen keine zwanzig Jahre Agenturerfahrung. Was ich Ihnen
            zusage: Sie sprechen mit mir und nicht mit einem Vertriebsteam, Sie bekommen
            eine ehrliche Einschätzung — auch wenn sie lautet, dass wir nicht passen — und
            alles, was wir bauen, gehört Ihnen.
          </p>
        </div>

        {
          !ausfuehrlich && (
            <div class="steig mt-10" style="--i:5">
              <a href="/ueber-uns" class="verweis text-schiefer">
                Mehr über die Arbeitsweise
                <svg viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5" aria-hidden="true">
                  <path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" />
                </svg>
              </a>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
