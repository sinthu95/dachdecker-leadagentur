---
import Marke from './Marke.astro';
import { fragen } from '../data/inhalte';
---

<section class="kapitel schnitt bg-papier" aria-labelledby="fragen-titel">
  <div class="schiene">
    <div class="grid gap-x-8 gap-y-8 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <Marke label="Häufige Fragen" />
        <h2 id="fragen-titel" class="mt-8 max-w-[14ch] text-gross lg:mt-10">
          Was Inhaber zuerst fragen.
        </h2>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <div class="border-t border-schiefer">
          {
            fragen.map((eintrag, i) => (
              <details class="steig group border-b border-linie-stark" style={`--i:${Math.min(i, 4)}`}>
                <summary class="flex cursor-pointer list-none items-start justify-between gap-8 py-6 text-[1.12rem] font-medium tracking-[-0.02em] transition-opacity duration-500 hover:opacity-60 [&::-webkit-details-marker]:hidden">
                  {eintrag.frage}
                  <span
                    class="relative mt-2 flex h-3 w-3 shrink-0 items-center justify-center"
                    aria-hidden="true"
                  >
                    <span class="absolute h-px w-3 bg-current" />
                    <span class="absolute h-3 w-px bg-current transition-transform duration-700 [transition-timing-function:var(--ease-linie)] group-open:rotate-90" />
                  </span>
                </summary>
                <p class="fliess max-w-[52ch] pb-7 text-klein">{eintrag.antwort}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
