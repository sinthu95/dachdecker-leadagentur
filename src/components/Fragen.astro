---
import Marke from './Marke.astro';
import { fragen } from '../data/inhalte';

interface Props {
  nr?: string;
}
const { nr = '·' } = Astro.props;
---

<section class="abschnitt border-t border-linie bg-schiefer" aria-labelledby="fragen-titel">
  <div class="shell">
    <div class="grid gap-y-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-3">
        <Marke nr={nr} label="Häufige Fragen" />
      </div>

      <div class="lg:col-span-9 xl:col-span-8">
        <h2 id="fragen-titel" class="steig text-display">
          Was Inhaber uns <span class="text-schnur-hell">zuerst</span> fragen.
        </h2>

        <div class="mt-12 border-t border-linie">
          {
            fragen.map((eintrag, i) => (
              <details class="steig group border-b border-linie" style={`--i:${Math.min(i, 4)}`}>
                <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-[1.08rem] font-semibold tracking-[-0.015em] transition-colors duration-300 hover:text-schnur-hell [&::-webkit-details-marker]:hidden">
                  {eintrag.frage}
                  <span
                    class="mt-1.5 flex h-4 w-4 shrink-0 items-center justify-center"
                    aria-hidden="true"
                  >
                    <span class="absolute h-px w-3.5 bg-current" />
                    <span class="h-3.5 w-px bg-current transition-transform duration-500 [transition-timing-function:var(--ease-schnur)] group-open:rotate-90" />
                  </span>
                </summary>
                <p class="measure-wide pb-7 text-klein text-zink-hell">{eintrag.antwort}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
