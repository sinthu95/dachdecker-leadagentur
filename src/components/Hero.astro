---
import Linie from './Linie.astro';
import Motiv from './Motiv.astro';
import { site, cta } from '../config/site';
import { brancheHolen } from '../data/branchen';

interface Props {
  /**
   * Schlüssel aus `src/data/branchen.ts`. Gesetzt: Der Hero spricht in der
   * Sprache dieser Branche — bestätigend statt spannungsaufbauend, denn wer
   * auf einer Branchenseite ankommt, hat bereits gesucht. Nicht gesetzt: der
   * Claim der branchenoffenen Hauptmarke.
   */
  branche?: string;
}
const { branche: brancheSchluessel } = Astro.props;
const branche = brancheHolen(brancheSchluessel);

/* Zeilenumbrüche sind gesetzt, nicht dem Zufall überlassen — sie tragen den
   Rhythmus der Titelseite.

   Der Claim der Hauptmarke ist branchenoffen und bewusst ohne
   Erfolgsversprechen: „Nachfrage entsteht nicht zufällig" sagt, dass Nachfrage
   gebaut wird — nicht, dass sie garantiert entsteht.

   Die Zeilen der Branchenseiten stehen nicht mehr hier, sondern in
   `branchen.ts`. Damit liegt alles, was an einer Branche anders ist, an einer
   einzigen Stelle, statt sich über die Komponenten zu verteilen. */
const zeilenHaupt = ['Nachfrage entsteht', 'nicht zufällig.'];
const zeilen = branche ? branche.hero.zeilen : zeilenHaupt;

/* Die Geometrie bleibt auf jeder Seite dieselbe — ihre Begründung nicht. Wo
   eine Branche den Winkel tatsächlich herleitet (Dach: Regeldachneigung),
   steht ihre Herleitung; sonst trägt er als Maß, nicht als Erzählung. */
const winkelSatz =
  branche?.winkel ?? 'Ein Winkel, ein Raster, eine Kurve. Jede Linie dieser Seite folgt ihnen.';
---

<section class="relative overflow-hidden bg-papier pt-24 lg:pt-28">
  <div class="schiene relative">
    <!-- Kopfzeile der Titelseite: Impressumszeile eines Magazins -->
    <div
      class="steig flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1 border-b border-linie pb-3 font-mono text-[0.62rem] tracking-[0.16em] text-graphit uppercase"
    >
      <span>{site.name} — {site.claim}</span>
      <span class="zahlen">{site.ort} · {site.gebiet}</span>
    </div>

    <!-- Der Titel über die volle Breite, die Zeilen treppen nach rechts:
         Die Setzung selbst zeichnet die Dachschräge nach, bevor irgendein
         Bild geladen ist. Unter 1024 px stehen die Zeilen bündig — auf der
         schmalen Fläche trägt die Größe allein. -->
    <div class="mt-10 lg:mt-14">
      <h1
        class="zeilen text-titel font-medium text-schiefer"
        style="font-family:var(--font-grotesk)"
      >
        {
          zeilen.map((z, i) => (
            <span class:list={['zeile', i === 1 && 'lg:ml-[8.333%]', i === 2 && 'lg:ml-[16.666%]', i === 3 && 'lg:ml-[25%]']}>
              <span style={`--i:${i}`}>{z}</span>
            </span>
          ))
        }
      </h1>
    </div>

    <!-- Vorspann und Handlung links; rechts die Konstruktion als Gegengewicht -->
    <div class="mt-12 grid gap-y-10 lg:mt-20 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-6 xl:col-span-5">
        {/* Die Staffel setzt hinter den vier Titelzeilen an (--i:0–3), damit
            die Ladefolge eine Richtung hat: Zeilen, Vorspann, Handlung. */}
        <p class="steig vorspann max-w-[38ch]" style="--i:3">
          {
            branche ? branche.hero.vorspann : site.erklaerung
          }
        </p>

        <div class="steig mt-9 flex flex-col gap-3 sm:flex-row sm:items-center" style="--i:4">
          <a href="/kontakt" class="knopf w-full sm:w-auto">
            {cta.primaer}
            <svg viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5" aria-hidden="true">
              <path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6"></path>
            </svg>
          </a>
          <a href="/leistungen" class="knopf knopf-linie w-full sm:w-auto">System ansehen</a>
        </div>

        <p class="steig mt-6 max-w-[46ch] text-klein text-graphit" style="--i:5">
          {cta.mikro}
        </p>
      </div>

      <!-- Die Konstruktion als Gegengewicht zum Text: Zeichnung und Bemaßung
           in einem Block. Sie zeichnet sich als Letztes — erst die Zeilen,
           dann der Vorspann, dann die Konstruktion. -->
      <div class="hidden lg:col-span-4 lg:col-start-9 lg:block lg:self-end">
        <div aria-hidden="true" style="--start:0.55s">
          <Linie art="dach" class="h-36 w-full text-schiefer opacity-45 xl:h-44" />
        </div>
        <div class="steig mt-5" style="--i:6">
          <div class="flex items-center gap-3">
            <span class="h-px flex-1 bg-linie-stark"></span>
            <span class="font-mono text-[0.62rem] tracking-[0.16em] text-graphit uppercase zahlen"
              >38°</span
            >
          </div>
          <p class="mt-3 text-[0.78rem] leading-relaxed text-graphit">{winkelSatz}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Große Bildfläche: der zweite Blick der Titelseite -->
  <div class="schiene relative mt-14 lg:mt-20">
    <div class="grid gap-4 lg:grid-cols-12 lg:gap-6">
      <div class="bildmaske lg:col-span-8">
        <Motiv
          name="beratung"
          nummer="B-01"
          motiv="Beratung vor dem Objekt — Fachbetrieb und Kundin im Gespräch, das Gebäude im Rücken."
          ausschnitt="Querformat, halbnah"
          class="w-full"
        />
      </div>
      <div class="bildmaske versatz hidden lg:col-span-4 lg:block" data-versatz="16" style="--i:1">
        <Motiv
          name="material"
          nummer="B-02"
          motiv="Materialstudie — Oberfläche im Wiederholungsmuster, Kante und Schattenkante im streifenden Licht."
          ausschnitt="Hochformat, Nahaufnahme"
          class="h-full w-full"
        />
      </div>
    </div>
  </div>
</section>
