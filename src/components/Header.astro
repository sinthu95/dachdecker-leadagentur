---
import Wortmarke from './Wortmarke.astro';
import { navigation } from '../data/inhalte';
import { site, cta } from '../config/site';

interface Props {
  /** Werbe-Landingpages laufen ohne Menü: ein Ziel, keine Abzweigungen. */
  fokus?: boolean;
}
const { fokus = false } = Astro.props;
const aktuell = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-[100] border-b border-transparent bg-papier transition-colors duration-700 [transition-timing-function:var(--ease-linie)]"
>
  <div class="schiene flex h-[4.2rem] items-center justify-between gap-6 lg:h-[4.8rem]">
    <a
      href="/"
      class="text-schiefer transition-opacity duration-500 hover:opacity-60"
      aria-label={`${site.name} — Startseite`}
    >
      <Wortmarke class="text-[1.08rem]" />
    </a>

    {
      !fokus && (
        <nav aria-label="Hauptnavigation" class="hidden items-center gap-10 lg:flex">
          {navigation.map((eintrag) => (
            <a
              href={eintrag.href}
              aria-current={aktuell === eintrag.href ? 'page' : undefined}
              class:list={[
                'relative font-mono text-[0.68rem] font-medium tracking-[0.15em] uppercase transition-colors duration-500',
                aktuell === eintrag.href ? 'text-schiefer' : 'text-graphit hover:text-schiefer',
              ]}
            >
              {eintrag.label}
              {aktuell === eintrag.href && (
                <span class="absolute -bottom-1.5 left-0 h-px w-full bg-schiefer" />
              )}
            </a>
          ))}
        </nav>
      )
    }

    <div class="flex items-center gap-4">
      <a
        href={`tel:${site.telefon}`}
        data-ereignis="call_click"
        class="tipp hidden font-mono text-[0.68rem] font-medium tracking-[0.1em] text-graphit transition-colors duration-500 hover:text-schiefer md:inline-block"
        >{site.telefonAnzeige}</a
      >
      <!-- Der Wortlaut bleibt überall identisch — auch auf der Werbeseite. -->
      <a
        href={fokus ? '#potenzialanalyse' : '/kontakt'}
        class="knopf hidden !px-6 !py-3 md:inline-flex"
      >
        {cta.primaer}
      </a>

      {
        !fokus && (
          <button
            type="button"
            data-menue-auf
            aria-expanded="false"
            aria-controls="mobilmenue"
            class="-mr-1 flex h-11 w-11 items-center justify-center text-schiefer lg:hidden"
          >
            <span class="sr-only">Menü öffnen</span>
            <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
              <path d="M3 8h18M3 16h18" stroke="currentColor" stroke-width="1.4" />
            </svg>
          </button>
        )
      }
    </div>
  </div>
</header>

{
  !fokus && (
    <dialog
      id="mobilmenue"
      data-menue
      class="m-0 h-dvh max-h-none w-full max-w-none bg-papier p-0 text-schiefer backdrop:bg-schiefer/70 lg:hidden"
    >
      <div class="flex h-full flex-col">
        <div class="schiene flex h-[4.2rem] shrink-0 items-center justify-between border-b border-linie">
          <Wortmarke class="text-[1.08rem]" />
          <button
            type="button"
            data-menue-zu
            class="-mr-1 flex h-11 w-11 items-center justify-center text-schiefer"
          >
            <span class="sr-only">Menü schließen</span>
            <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
              <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.4" />
            </svg>
          </button>
        </div>

        <nav aria-label="Hauptnavigation mobil" class="schiene flex-1 overflow-y-auto py-4">
          <ul class="flex flex-col">
            {navigation.map((eintrag, i) => (
              <li class="border-b border-linie">
                <a
                  href={eintrag.href}
                  class="flex items-baseline justify-between gap-4 py-5 text-[1.75rem] font-medium tracking-[-0.03em]"
                >
                  {eintrag.label}
                  <span class="font-mono text-[0.6rem] font-normal tracking-[0.14em] text-graphit zahlen">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="schiene shrink-0 space-y-3 border-t border-linie py-6">
          <a href="/kontakt" class="knopf w-full">{cta.primaer}</a>
          <a
            href={`tel:${site.telefon}`}
            data-ereignis="call_click"
            class="knopf knopf-linie w-full"
          >
            {site.telefonAnzeige}
          </a>
        </div>
      </div>
    </dialog>
  )
}
