---
import Marke from './Marke.astro';
import { wettbewerb } from '../data/inhalte';
---

<section class="kapitel schnitt bg-papier" aria-labelledby="realitaet-titel">
  <div class="schiene">
    <div class="grid gap-x-8 gap-y-8 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <Marke label="Die neue Realität" />
        <h2 id="realitaet-titel" class="zeilen mt-8 max-w-[20ch] text-gross lg:mt-10">
          <span class="zeile"><span style="--i:0">Empfehlungen bringen Aufträge.</span></span>
          <span class="zeile"
            ><span style="--i:1" class="text-graphit">Aber nicht auf Bestellung.</span></span
          >
        </h2>
      </div>
      <div class="lg:col-span-4 lg:col-start-9 lg:self-end">
        <p class="steig vorspann" style="--i:1">
          Empfehlung bleibt der beste Kanal, den ein Handwerksbetrieb haben kann. Sie hat
          nur einen Konstruktionsfehler: Sie lässt sich nicht aufdrehen, wenn der Kalender
          im Februar Lücken zeigt.
        </p>
      </div>
    </div>

    <!-- Was der Betrieb kennt, dem gegenübergestellt, was wir dagegensetzen.
         Zeilen mit harten Linien, keine Kacheln. -->
    <div class="mt-12 lg:mt-16">
      <p class="steig marke">Womit Sie uns vergleichen</p>
      <div class="mt-6 border-t border-schiefer">
        {
          wettbewerb.map((zeile, i) => (
            <div
              class="steig grid gap-x-8 gap-y-3 border-b border-linie-stark py-7 lg:grid-cols-12 lg:py-9"
              style={`--i:${i}`}
            >
              <div class="lg:col-span-3">
                <p class="text-[1.15rem] font-medium tracking-[-0.02em]">{zeile.was}</p>
                {zeile.zusatz && <p class="marke mt-1.5">{zeile.zusatz}</p>}
              </div>
              <p
                class="max-w-[40ch] font-serife text-[1.02rem] leading-relaxed text-graphit italic lg:col-span-4"
              >
                „{zeile.denkt}"
              </p>
              <p class="fliess max-w-[44ch] text-schiefer lg:col-span-4 lg:col-start-9">
                {zeile.antwort}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
