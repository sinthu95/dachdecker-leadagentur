---
import { orientierung } from '../data/inhalte';

/** Schmale Leiste unter dem Titel: drei Fakten, die sofort einordnen. */
---

<section class="schnitt bg-papier" aria-label="Einordnung">
  <div class="schiene">
    <dl class="grid divide-y divide-linie sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      {
        orientierung.map((eintrag, i) => (
          <div
            class="steig flex items-baseline gap-4 py-5 sm:block sm:py-8 sm:first:pr-10 sm:not-first:pl-10"
            style={`--i:${i}`}
          >
            <dt class="marke sm:mb-3">{eintrag.k}</dt>
            <dd class="text-[1rem] text-schiefer sm:text-[1.15rem]">{eintrag.v}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
