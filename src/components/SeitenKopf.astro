---
interface Props {
  marke: string;
  titel: string;
  akzent?: string;
  text?: string;
}
const { marke, titel, akzent, text } = Astro.props;
---

<section class="relative overflow-hidden border-b border-linie bg-schiefer pt-40 pb-16 lg:pt-52 lg:pb-24">
  <div class="raster text-kalk" aria-hidden="true"></div>
  <svg
    class="pointer-events-none absolute inset-x-0 bottom-0 h-40 w-full opacity-60"
    viewBox="0 0 1440 160"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      class="zeichne"
      d="M-40 160 720 12 1480 160"
      fill="none"
      stroke="var(--color-schnur)"
      stroke-width="1"
      vector-effect="non-scaling-stroke"></path>
  </svg>

  <div class="shell relative">
    <p class="marke steig">
      <span class="marke-num zahlen">·</span>
      <span>{marke}</span>
    </p>
    <h1 class="steig mt-6 max-w-4xl text-display" style="--i:1">
      {titel}{akzent && <span class="text-schnur-hell"> {akzent}</span>}
    </h1>
    {
      text && (
        <p class="steig measure-wide mt-7 text-lead text-zink-hell" style="--i:2">
          {text}
        </p>
      )
    }
  </div>
</section>
