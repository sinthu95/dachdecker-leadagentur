---
import Linie from './Linie.astro';

interface Props {
  marke: string;
  /** Zeilenumbrüche werden gesetzt, nicht dem Zufall überlassen. */
  zeilen: string[];
  text?: string;
}
const { marke, zeilen, text } = Astro.props;
---

<section class="relative overflow-hidden bg-papier pt-28 pb-14 lg:pt-36 lg:pb-20">
  <div class="schiene relative">
    <div
      class="steig flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1 border-b border-linie pb-3"
    >
      <span class="marke">{marke}</span>
      <span class="marke zahlen">38°</span>
    </div>

    <div class="mt-10 grid items-end gap-8 lg:mt-14 lg:grid-cols-12">
      <h1 class="zeilen max-w-[20ch] text-gross lg:col-span-9">
        {
          zeilen.map((z, i) => (
            <span class="zeile">
              <span style={`--i:${i}`}>{z}</span>
            </span>
          ))
        }
      </h1>
      <div class="hidden lg:col-span-3 lg:block" aria-hidden="true">
        <Linie art="dach" class="h-24 w-full text-schiefer opacity-40" />
      </div>
    </div>

    {
      text && (
        <p class="steig vorspann mt-10 max-w-[46ch]" style="--i:1">
          {text}
        </p>
      )
    }
  </div>
</section>
