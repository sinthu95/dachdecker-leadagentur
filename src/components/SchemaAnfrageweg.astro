---
import Marke from './Marke.astro';
import { anfrageweg } from '../data/inhalte';

/**
 * Der Anfrageweg als Zeichnung.
 *
 * Vier Stationen, vier abstrahierte Ausschnitte: eine Suche, eine Anzeige,
 * eine Seite, eine Anfrage. Bewusst als Konstruktionszeichnung und nicht als
 * Bildschirmfoto — es gibt keinen realen Betrieb, dessen Konto wir hier
 * zeigen könnten, und ein nachgebautes Foto wäre eine Behauptung.
 *
 * Die Beschreibungszeilen der Anzeige stehen als Haarlinien statt als Text:
 * Was dort steht, hängt vom Betrieb ab. Erfundener Anzeigentext wäre
 * Ausschmückung, keine Erklärung.
 */
const { gesucht, ausgeschlossen, stationen, felder } = anfrageweg;
---

<section class="kapitel schnitt bg-papier" aria-labelledby="anfrageweg-titel">
  <div class="schiene">
    <div class="grid gap-x-8 gap-y-8 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <Marke label="Schema · Anfrageweg" />
        <h2 id="anfrageweg-titel" class="mt-8 max-w-[17ch] text-gross lg:mt-10">
          Wie aus einer Suche ein Termin auf dem Dach wird.
        </h2>
      </div>
      <div class="lg:col-span-4 lg:col-start-9 lg:self-end">
        <p class="steig vorspann" style="--i:1">
          Vier Stationen, an denen jeweils etwas schiefgehen kann. Deshalb bauen wir sie
          zusammen und nicht einzeln.
        </p>
      </div>
    </div>

    <!-- ================================================================
         Die Zeichnung
         ================================================================ -->
    <ol class="mt-14 grid gap-x-8 gap-y-12 lg:mt-16 lg:grid-cols-4">
      {
        stationen.map((station, i) => (
          <li class="steig relative" style={`--i:${i}`}>
            {/* Richtungsmarke im Spaltenabstand — nur zwischen den Stationen */}
            {i > 0 && (
              <span
                class="absolute top-[8.5rem] -left-[1.45rem] hidden h-2 w-2 rotate-[-45deg] border-t border-r border-linie-stark lg:block"
                aria-hidden="true"
              />
            )}

            <div class="flex items-baseline gap-3 border-t border-schiefer pt-3">
              <span class="marke zahlen">{String(i + 1).padStart(2, '0')}</span>
              <span class="vermessung">{station.marke}</span>
            </div>

            {/* --- Der abstrahierte Ausschnitt ------------------------- */}
            <div
              class="mt-5 flex h-[11.5rem] flex-col justify-center border border-linie-stark bg-kalkstein p-5"
              aria-hidden="true"
            >
              {i === 0 && (
                <div class="space-y-0">
                  {gesucht.map((wort) => (
                    <p class="flex items-baseline gap-2.5 border-b border-linie py-2 font-mono text-[0.68rem] text-schiefer last:border-b-0">
                      <span class="text-graphit">›</span>
                      <span class="truncate">{wort}</span>
                    </p>
                  ))}
                </div>
              )}

              {i === 1 && (
                <div>
                  <p class="font-mono text-[0.58rem] tracking-[0.12em] text-graphit uppercase">
                    Anzeige · ihre-domain.de
                  </p>
                  <p class="mt-2.5 text-[1rem] leading-tight font-medium tracking-[-0.02em]">
                    Flachdach abdichten
                    <br />
                    im eigenen Umkreis
                  </p>
                  <span class="mt-4 block h-px w-full bg-linie-stark" />
                  <span class="mt-2 block h-px w-4/5 bg-linie-stark" />
                  <span class="mt-2 block h-px w-3/5 bg-linie-stark" />
                </div>
              )}

              {i === 2 && (
                <div class="border border-linie-stark bg-papier">
                  <span class="block h-3 w-full border-b border-linie-stark bg-beton" />
                  <div class="space-y-1.5 p-2.5">
                    <span class="block h-8 w-full bg-beton" />
                    <span class="block h-px w-5/6 bg-linie-stark" />
                    <span class="block h-px w-2/3 bg-linie-stark" />
                  </div>
                  <p class="m-2.5 mt-0 bg-schiefer px-2 py-1 text-center font-mono text-[0.55rem] tracking-[0.14em] text-papier uppercase">
                    Anfrage
                  </p>
                </div>
              )}

              {i === 3 && (
                <ul class="space-y-0">
                  {felder.map((feld) => (
                    <li class="flex items-baseline gap-2.5 border-b border-linie py-[0.36rem] font-mono text-[0.63rem] tracking-[0.06em] text-schiefer last:border-b-0">
                      <span class="mt-[0.5em] h-px w-2.5 shrink-0 bg-moos" />
                      <span class="truncate">{feld}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <h3 class="mt-5 text-[1.1rem] leading-snug font-medium tracking-[-0.02em]">
              {station.titel}
            </h3>
            <p class="fliess mt-2 max-w-[34ch] text-klein">{station.text}</p>
          </li>
        ))
      }
    </ol>

    <!-- ================================================================
         Was ausgeschlossen wird — der unsichtbare Teil der Arbeit
         ================================================================ -->
    <div class="steig mt-14 grid gap-x-8 gap-y-4 border-t border-schiefer pt-6 lg:grid-cols-12">
      <div class="lg:col-span-3">
        <p class="vermessung">Ausgeschlossen</p>
      </div>
      <ul class="flex flex-wrap gap-x-6 gap-y-2 lg:col-span-5">
        {
          ausgeschlossen.map((wort) => (
            <li class="font-mono text-[0.68rem] text-graphit line-through decoration-zinnober/70">
              {wort}
            </li>
          ))
        }
      </ul>
      <p class="fliess max-w-[46ch] text-klein lg:col-span-4">
        Diese Suchen kosten Geld und bringen keinen Auftrag. Sie auszuschließen ist die
        Arbeit, die man auf keiner Rechnung sieht — und die den Unterschied macht.
      </p>
    </div>
  </div>
</section>
