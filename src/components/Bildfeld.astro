---
/**
 * Gestalteter Bildplatz.
 *
 * Für die Fotografie, die dieses Projekt braucht, liegt noch kein Material vor.
 * Statt Fotos zu erfinden oder Stockmotive einzusetzen, steht hier eine bewusst
 * komponierte Fläche: Steinton, Vermessungsmarken an den Ecken, Bemaßung und
 * eine technische Bildunterschrift, die Motiv und Format benennt.
 *
 * Sobald eine Aufnahme vorliegt, ersetzt sie den Inhalt dieses Feldes eins zu
 * eins — Format, Ausschnitt und Platzierung stehen bereits fest. Die
 * vollständige Bildliste steht im README unter „Benötigte Fotografie".
 */
interface Props {
  /** Kurzbeschreibung des Motivs, erscheint als Bildunterschrift. */
  motiv: string;
  /** Seitenverhältnis, z. B. '4/5', '16/9', '3/2'. */
  format?: string;
  /** Eigener Ausschnitt für kleine Bildschirme — Mobil ist kein Desktop. */
  formatMobil?: string;
  /** Laufende Nummer im Bildplan, z. B. 'B-04'. */
  nummer?: string;
  /** Zusatz zum Ausschnitt oder zur Aufnahmesituation. */
  ausschnitt?: string;
  dunkel?: boolean;
  class?: string;
}
const {
  motiv,
  format = '4/5',
  formatMobil,
  nummer,
  ausschnitt,
  dunkel = false,
  class: klasse = '',
} = Astro.props;
---

<figure
  class:list={[
    'bildfeld relative isolate overflow-hidden',
    /* Die Beschriftung trägt echten Inhalt und steht deshalb im vollen
       Textton. Die Zeichnung darunter ist Dekoration und bekommt ihren
       eigenen, leiseren Ton — sonst müsste die Schrift für die Ruhe der
       Fläche bezahlen. */
    dunkel ? 'bg-tinte text-papier-gedimmt' : 'bg-beton text-schiefer',
    klasse,
  ]}
  style={`--verh:${format};--verh-mobil:${formatMobil ?? format}`}
>
  <!-- Feines Raster: gibt der leeren Fläche Struktur, ohne sie zu füllen -->
  <div
    class:list={['absolute inset-0 opacity-[0.5]', dunkel ? 'text-graphit-hell' : 'text-kies']}
    aria-hidden="true"
    style="background-image:linear-gradient(to right,currentColor 1px,transparent 1px),linear-gradient(to bottom,currentColor 1px,transparent 1px);background-size:clamp(48px,7%,110px) clamp(48px,7%,110px)"
  >
  </div>

  <!-- Dachneigung als Andeutung, sehr zurückgenommen -->
  <svg
    class:list={[
      'absolute inset-0 h-full w-full opacity-80',
      dunkel ? 'text-graphit-hell' : 'text-kies',
    ]}
    viewBox="0 0 400 500"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path d="M-20 430 200 258 420 430" fill="none" stroke="currentColor" stroke-width="1"></path>
  </svg>

  <!-- Vermessungsmarken in den Ecken -->
  {
    [
      'left-4 top-4',
      'right-4 top-4',
      'left-4 bottom-4',
      'right-4 bottom-4',
    ].map((pos) => (
      <span
        class:list={[
          'absolute h-3 w-3',
          dunkel ? 'text-graphit-hell' : 'text-kies',
          pos,
        ]}
        aria-hidden="true"
      >
        <span class="absolute left-1/2 top-0 h-full w-px -translate-x-1/2 bg-current" />
        <span class="absolute top-1/2 left-0 h-px w-full -translate-y-1/2 bg-current" />
      </span>
    ))
  }

  <!-- Technische Beschriftung -->
  <figcaption
    class="absolute inset-x-0 bottom-0 flex flex-wrap items-end justify-between gap-x-6 gap-y-1 p-4 sm:p-5"
  >
    <span class="font-mono text-[0.6rem] tracking-[0.16em] uppercase">
      {nummer && <span class="zahlen">{nummer} · </span>}Bildfeld — Aufnahme folgt
    </span>
    <span class="zahlen font-mono text-[0.6rem] tracking-[0.16em] uppercase">
      {format.replace('/', ':')}
    </span>
  </figcaption>

  <div class="absolute inset-x-0 top-0 p-4 sm:p-5">
    <p class="max-w-[26ch] text-[0.92rem] leading-snug font-medium">{motiv}</p>
    {
      ausschnitt && (
        <p class="mt-1.5 font-mono text-[0.6rem] tracking-[0.14em] uppercase">{ausschnitt}</p>
      )
    }
  </div>
</figure>
