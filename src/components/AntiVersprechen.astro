---
import Marke from './Marke.astro';

const nicht = [
  'Garantierte Anfragezahlen',
  'Kundenlogos, die wir nicht haben',
  'Bewertungen, die niemand abgegeben hat',
  'Fallstudien mit erfundenen Ergebnissen',
  'Rabatte, die morgen ablaufen',
  'Auszeichnungen, die wir uns selbst verliehen haben',
];
---

<section class="kapitel schnitt stein" aria-labelledby="ehrlich-titel">
  <div class="schiene">
    <div class="grid gap-x-8 gap-y-12 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <Marke label="Ehrlichkeit" />
        <h2 id="ehrlich-titel" class="mt-8 max-w-[15ch] text-gross lg:mt-10">
          Was wir Ihnen nicht versprechen.
        </h2>

        <div class="mt-10 space-y-6">
          <p class="steig vorspann max-w-[42ch]" style="--i:1">
            Keine Zahl. Wer Ihnen ohne Kenntnis Ihres Einzugsgebiets, Ihrer Preise und
            Ihrer Kapazität „30 Anfragen im Monat" garantiert, verkauft Ihnen eine Zahl —
            keine Kunden.
          </p>
          <p class="steig fliess max-w-[46ch]" style="--i:2">
            Und wir sind neu. S&amp;S Leadcraft ist 2026 entstanden, mit einem klaren Fokus
            statt einer langen Kundenliste. Wir könnten diese Seite mit Logos und
            Sternebewertungen füllen; es würde niemandem auffallen. Wir tun es nicht — denn
            wenn wir hier erfinden würden, was hätten Sie dann von unseren Berichten zu
            erwarten?
          </p>
        </div>
      </div>

      <div class="lg:col-span-5 lg:col-start-8">
        <p class="steig marke">Was Sie auf dieser Seite deshalb nicht finden</p>
        <ul class="mt-7 border-t border-linie-stark">
          {
            nicht.map((eintrag, i) => (
              <li
                class="steig flex items-baseline gap-4 border-b border-linie py-3.5"
                style={`--i:${i}`}
              >
                <span class="h-px w-5 shrink-0 translate-y-[-0.35em] bg-zinnober" aria-hidden="true" />
                <span class="text-[0.98rem] text-graphit line-through decoration-zinnober/55 decoration-1">
                  {eintrag}
                </span>
              </li>
            ))
          }
        </ul>

        <p class="steig fliess mt-8 max-w-[42ch] text-klein">
          Was Sie stattdessen prüfen können: unsere Arbeit, unser Vorgehen und ob wir Ihre
          Branche verstehen. Genau dafür ist die Potenzialanalyse da — und dafür haben wir
          den Concept Case gebaut.
        </p>
      </div>
    </div>
  </div>
</section>
