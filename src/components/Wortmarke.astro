---
/**
 * Typografische Wortmarke. Über dem Ampersand sitzt die Dachneigung als
 * feine Konstruktionslinie — dasselbe Motiv wie im Liniensystem der Seite.
 */
interface Props {
  class?: string;
}
const { class: klasse = '' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-baseline gap-[0.4em] font-grotesk font-medium tracking-[-0.03em] whitespace-nowrap',
    klasse,
  ]}
>
  <span class="relative inline-block">
    S&amp;S
    <svg
      class="pointer-events-none absolute -top-[0.36em] left-0 w-full"
      viewBox="0 0 100 10"
      preserveAspectRatio="none"
      aria-hidden="true"
      style="height:0.28em"
    >
      <path
        d="M0 9 50 1 100 9"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        vector-effect="non-scaling-stroke"></path>
    </svg>
  </span>
  <span class="font-normal opacity-65">Leadcraft</span>
</span>
