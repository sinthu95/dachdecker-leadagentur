---
import { site, cta } from '../config/site';

interface Props {
  titel?: string;
  text?: string;
}
const {
  titel = 'Sehen wir uns Ihr Einzugsgebiet an.',
  text = 'Vierzig Minuten, kostenfrei, mit einer ehrlichen Einschätzung am Ende — auch wenn sie lautet, dass wir nicht passen.',
} = Astro.props;
---

<section class="relative overflow-hidden border-t border-linie bg-blei">
  <svg
    class="pointer-events-none absolute inset-0 h-full w-full opacity-50"
    viewBox="0 0 1440 420"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      class="zeichne"
      d="M-40 420 720 40 1480 420"
      fill="none"
      stroke="var(--color-schnur)"
      stroke-width="1"
      vector-effect="non-scaling-stroke"></path>
  </svg>

  <div class="shell relative py-24 lg:py-32">
    <div class="grid items-end gap-y-10 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <h2 class="steig text-display">{titel}</h2>
        <p class="steig measure-wide mt-6 text-lead text-zink-hell" style="--i:1">{text}</p>
      </div>

      <div class="lg:col-span-5 lg:pl-8">
        <div class="steig flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row" style="--i:2">
          <a href="/kontakt" class="btn w-full sm:w-auto lg:w-full xl:w-auto">
            {cta.primaer}
            <svg viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5" aria-hidden="true">
              <path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8"></path>
            </svg>
          </a>
          <a
            href={`tel:${site.telefon}`}
            data-ereignis="call_click"
            class="btn btn-linie w-full sm:w-auto lg:w-full xl:w-auto"
          >
            {site.telefonAnzeige}
          </a>
        </div>
        <p class="steig mt-5 text-[0.82rem] leading-relaxed text-zink" style="--i:3">
          {site.erreichbarkeit} · {site.emailHinweis}
        </p>
      </div>
    </div>
  </div>
</section>
