---
import Marke from './Marke.astro';
import Motiv from './Motiv.astro';
---

<section class="kapitel schnitt bg-papier" aria-labelledby="problem-titel">
  <div class="schiene">
    <Marke label="Das Problem" />

    <!-- Der Kontrast steckt in der Komposition: zwei Zeilen, eine Zäsur. -->
    <h2 id="problem-titel" class="zeilen mt-10 max-w-[22ch] text-gross lg:mt-14">
      <span class="zeile"><span style="--i:0">Hervorragende Arbeit.</span></span>
      <span class="zeile"
        ><span style="--i:1" class="text-graphit">Durchschnittlicher Auftritt.</span></span
      >
    </h2>

    <div class="mt-12 grid gap-x-8 gap-y-12 lg:mt-16 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="steig vorspann">
          Die meisten Dachdeckerbetriebe, die wir uns ansehen, liefern handwerklich
          ausgezeichnete Arbeit. Ihr digitaler Auftritt erzählt davon nichts.
        </p>
        <div class="fliess mt-8 space-y-5">
          <p class="steig" style="--i:1">
            Die Website stammt aus dem Jahr 2016, lädt langsam, ist auf dem Telefon mühsam
            zu bedienen und sagt nicht, welche Arbeiten der Betrieb eigentlich am liebsten
            macht.
          </p>
          <p class="steig" style="--i:2">
            Das ist kein Schönheitsproblem. Wer eine Dachsanierung plant, vergleicht abends
            auf dem Sofa drei Betriebe. Er kennt keinen davon persönlich. Er entscheidet
            nach dem, was er sieht — und er sieht nicht die Qualität Ihrer Arbeit, sondern
            die Qualität Ihres Auftritts.
          </p>
        </div>
      </div>

      <div class="bildmaske lg:col-span-7">
        <Motiv
          name="dacharbeit-flaeche"
          nummer="B-03"
          motiv="Dachdecker bei der präzisen Arbeit am Falz — Hände, Werkzeug, Materialkante. Konzentration statt Pose."
          ausschnitt="Querformat, halbnah, natürliches Licht"
        />
      </div>
    </div>

    <!-- Die Folgerung als Zitat, in der Serife — der Ton wechselt bewusst.
         Über die volle Satzbreite gesetzt, damit sie als Zäsur gelesen wird
         und nicht als Absatz, der links liegen geblieben ist. -->
    <figure class="mt-14 border-t border-schiefer pt-8 lg:mt-20 lg:pt-10">
      <div class="grid gap-x-8 gap-y-4 lg:grid-cols-12">
        <p class="steig vermessung lg:col-span-2">Folgerung</p>
        <blockquote class="steig lg:col-span-8" style="--i:1">
          <p class="zitat text-[clamp(1.5rem,2.9vw,2.5rem)] leading-[1.22]">
            Nicht der bessere Betrieb bekommt die Anfrage. Der sichtbarere.
          </p>
        </blockquote>
        <p class="steig fliess text-klein lg:col-span-2 lg:pt-2" style="--i:2">
          Das ist keine Meinung, sondern die Reihenfolge, in der abends verglichen wird.
        </p>
      </div>
    </figure>
  </div>
</section>
