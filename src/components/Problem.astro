---
import Marke from './Marke.astro';
import Motiv from './Motiv.astro';
import Bildfeld from './Bildfeld.astro';
import { brancheHolen } from '../data/branchen';

interface Props {
  /** Schlüssel aus `src/data/branchen.ts`. */
  branche?: string;
}
const { branche: brancheSchluessel } = Astro.props;
const branche = brancheHolen(brancheSchluessel);

/**
 * Die Bildfläche dieses Abschnitts.
 *
 * Hier stand auf der Startseite das Motiv `dacharbeit-flaeche`: ein Mann mit
 * Auffanggurt auf einer Ziegeldachfläche. Neben einem Text, der von „den
 * meisten Unternehmen" spricht, sagt dieses Bild etwas anderes als der Text —
 * es ordnet die Marke wieder einem einzigen Gewerk zu. Es steht deshalb nur
 * noch auf der Branchenseite, wo es stimmt.
 *
 * Auf der Hauptseite steht bis zu einer branchenoffenen Aufnahme das
 * gestaltete Bildfeld mit festgelegtem Motiv. Das ist der vorgesehene Weg für
 * fehlende Fotografie: Motiv, Ausschnitt und Format stehen fest, erfunden wird
 * nichts. Die Aufnahme ist im README unter „Benötigte Fotografie" geführt.
 */
const zeigeMotiv = branche?.schluessel === 'dachdecker';
---

<section class="kapitel schnitt bg-papier" aria-labelledby="problem-titel">
  <div class="schiene">
    <Marke label="Das Problem" />

    <!-- Der Kontrast steckt in der Komposition: zwei Zeilen, eine Zäsur. -->
    <h2 id="problem-titel" class="zeilen mt-10 max-w-[22ch] text-gross lg:mt-14">
      <span class="zeile"><span style="--i:0">Hervorragende Arbeit.</span></span>
      <span class="zeile"
        ><span style="--i:1" class="text-graphit">Durchschnittlicher Auftritt.</span></span
      >
    </h2>

    <div class="mt-12 grid gap-x-8 gap-y-12 lg:mt-16 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="steig vorspann">
          Die meisten {branche ? branche.betriebe : 'Unternehmen'}, die wir uns ansehen,
          liefern ausgezeichnete Arbeit. Ihr digitaler Auftritt erzählt davon nichts.
        </p>
        <div class="fliess mt-8 space-y-5">
          <p class="steig" style="--i:1">
            Die Website stammt aus dem Jahr 2016, lädt langsam, ist auf dem Telefon mühsam
            zu bedienen und sagt nicht, welche Aufträge der Betrieb eigentlich am liebsten
            annimmt.
          </p>
          <p class="steig" style="--i:2">
            Das ist kein Schönheitsproblem. Wer einen Auftrag zu vergeben hat, vergleicht
            abends drei Anbieter. Er kennt keinen davon persönlich. Er entscheidet nach
            dem, was er sieht — und er sieht nicht die Qualität Ihrer Arbeit, sondern die
            Qualität Ihres Auftritts.
          </p>
        </div>
      </div>

      <div class="bildmaske lg:col-span-7">
        {
          zeigeMotiv ? (
            <Motiv
              name="dacharbeit-flaeche"
              nummer="B-03"
              motiv="Dachdecker bei der präzisen Arbeit am Falz — Hände, Werkzeug, Materialkante. Konzentration statt Pose."
              ausschnitt="Querformat, halbnah, natürliches Licht"
            />
          ) : (
            <Bildfeld
              nummer="B-03"
              motiv="Präzise Handarbeit ohne erkennbares Gewerk — Hände, Werkzeug, Werkstück. Konzentration statt Pose."
              ausschnitt="Querformat, halbnah, natürliches Licht"
              format="3/2"
              formatMobil="4/5"
            />
          )
        }
      </div>
    </div>

    <!-- Die Folgerung als Zitat, in der Serife — der Ton wechselt bewusst.
         Über die volle Satzbreite gesetzt, damit sie als Zäsur gelesen wird
         und nicht als Absatz, der links liegen geblieben ist. -->
    <figure class="mt-14 border-t border-schiefer pt-8 lg:mt-20 lg:pt-10">
      <div class="grid gap-x-8 gap-y-4 lg:grid-cols-12">
        <p class="steig vermessung lg:col-span-2">Folgerung</p>
        <blockquote class="steig lg:col-span-8" style="--i:1">
          <p class="zitat text-[clamp(1.5rem,2.9vw,2.5rem)] leading-[1.22]">
            Nicht der bessere Betrieb bekommt die Anfrage. Der sichtbarere.
          </p>
        </blockquote>
        <p class="steig fliess text-klein lg:col-span-2 lg:pt-2" style="--i:2">
          Das ist keine Meinung, sondern die Reihenfolge, in der abends verglichen wird.
        </p>
      </div>
    </figure>
  </div>
</section>
