---
import Marke from './Marke.astro';
import { passung } from '../data/inhalte';
---

<section class="kapitel schnitt bg-papier" aria-labelledby="passung-titel">
  <div class="schiene">
    <div class="grid gap-x-8 gap-y-8 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <Marke label="Passung" />
        <h2 id="passung-titel" class="mt-8 max-w-[18ch] text-gross lg:mt-10">
          Nicht jeder Betrieb ist passend.
        </h2>
      </div>
      <div class="lg:col-span-4 lg:col-start-9 lg:self-end">
        <p class="steig vorspann" style="--i:1">
          Wir arbeiten mit einem Dachdeckerbetrieb je Einzugsgebiet. Das zwingt uns zu
          einer Auswahl — und Ihnen erspart es ein Gespräch, das ohnehin zu nichts führt.
        </p>
      </div>
    </div>

    <!-- Zwei Spalten, getrennt durch eine Linie. Keine Kästen, keine Häkchen. -->
    <div class="mt-12 grid gap-x-16 gap-y-12 lg:mt-16 lg:grid-cols-2">
      <div>
        <h3 class="steig marke border-b border-schiefer pb-3 text-schiefer">Passt</h3>
        <ul class="mt-0">
          {
            passung.ja.map((p, i) => (
              <li
                class="steig flex items-baseline gap-4 border-b border-linie py-4 text-[1.02rem]"
                style={`--i:${i}`}
              >
                <span class="h-px w-4 shrink-0 translate-y-[-0.35em] bg-moos" aria-hidden="true" />
                {p}
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="steig marke border-b border-linie-stark pb-3">Passt nicht</h3>
        <ul class="mt-0">
          {
            passung.nein.map((p, i) => (
              <li
                class="steig flex items-baseline gap-4 border-b border-linie py-4 text-[1.02rem] text-graphit"
                style={`--i:${i}`}
              >
                <span
                  class="h-px w-4 shrink-0 translate-y-[-0.35em] bg-zinnober"
                  aria-hidden="true"
                />
                {p}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="steig fliess mt-10 max-w-[56ch] text-klein">
      Wenn Sie in der rechten Spalte stehen, sagen wir das im Erstgespräch — und nennen
      Ihnen, wenn möglich, den sinnvolleren nächsten Schritt.
    </p>
  </div>
</section>
