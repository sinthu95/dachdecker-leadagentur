---
import Marke from './Marke.astro';
import Bildfeld from './Bildfeld.astro';
import { BRANCHEN_PFAD, branchen } from '../data/branchen';

interface Props {
  /** Auf `/branchen` selbst führt der Verweis auf die Seite, die man liest. */
  verweis?: boolean;
}
const { verweis = true } = Astro.props;

/* Nur die Zahl, keine Aufzählung geplanter Gewerke: Was es gibt, steht auf der
   Übersicht — was es nicht gibt, wird auch nicht angedeutet. */
const anzahl = branchen.length;

const gruende = [
  {
    titel: 'Die Technik bleibt gleich',
    text: 'Website, Werbung, Anfragestrecke, Messung, Optimierung — dieser Ablauf ist in jeder Branche derselbe. Er ist gebaut, geprüft und nachvollziehbar, und er muss nicht für jeden Kunden neu erfunden werden.',
  },
  {
    titel: 'Die Ausgestaltung nicht',
    text: 'Wonach gesucht wird, welche Leistung sich lohnt, welche Einwände zuerst kommen und welche Frage eine Anfrage brauchbar macht — das unterscheidet sich je Branche erheblich. Genau dort steckt die Arbeit.',
  },
  {
    titel: 'Schlechte Anfragen sehen überall anders aus',
    text: 'In jeder Branche gibt es Suchbegriffe, die zuverlässig Anfragen bringen, aus denen nie ein Auftrag wird. Welche das sind, lässt sich nicht raten — es wird gemessen und dann ausgeschlossen.',
  },
  {
    titel: 'Jedes Projekt verdichtet das Wissen',
    text: 'Was in einer Branche funktioniert, macht das nächste Projekt darin besser. Deshalb entstehen eigene Landingpages je Branche statt einer Seite, die für alle gleichzeitig sprechen soll.',
  },
];
---

<section class="kapitel schnitt bg-papier" aria-labelledby="spezialisierung-titel">
  <div class="schiene">
    <!-- Materialität zuerst: die Bildfläche trägt den Abschnitt -->
    <div class="grid gap-x-8 gap-y-12 lg:grid-cols-12">
      <div class="bildmaske lg:col-span-5">
        <Bildfeld
          nummer="B-05"
          motiv="Werkstück und Werkzeug im Streiflicht — Materialität ohne Gewerk, Oberflächen und Kanten deutlich."
          ausschnitt="Hochformat, Nahaufnahme, Materialstudie"
          format="4/5"
          class="h-full w-full"
        />
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <Marke label="Spezialisierung" />
        <h2 id="spezialisierung-titel" class="mt-8 max-w-[17ch] text-gross lg:mt-10">
          Ein System. Branchentief angewandt.
        </h2>
        <p class="steig vorspann mt-8" style="--i:1">
          Es gibt genug Agenturen, die alles für alle machen. Der Unterschied liegt nicht
          im Ablauf — der ist überall derselbe —, sondern darin, wie genau er auf eine
          Branche zugeschnitten wird.
        </p>

        <dl class="mt-12 border-t border-schiefer">
          {
            gruende.map((grund, i) => (
              <div class="steig border-b border-linie-stark py-6" style={`--i:${i}`}>
                <dt class="text-[1.1rem] font-medium tracking-[-0.015em]">{grund.titel}</dt>
                <dd class="fliess mt-2 max-w-[52ch] text-klein">{grund.text}</dd>
              </div>
            ))
          }
        </dl>

        {
          verweis && (
            <div class="steig mt-10">
              <a href={BRANCHEN_PFAD} class="verweis text-schiefer">
                {anzahl === 1 ? 'Die erste Branchenseite' : 'Alle Branchenseiten'}
                <svg viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5" aria-hidden="true">
                  <path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" />
                </svg>
              </a>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
