---
/**
 * Kapitelmarke als Vermessungsmarke: ein kurzer Strich, dann das Wort.
 *
 * Die frühere durchnummerierte Fassung (01 … 10 über jedem Abschnitt) ist
 * bewusst entfallen — sie gab der Seite einen mechanischen Takt. Nummern
 * erscheinen jetzt nur noch dort, wo sie etwas bedeuten: im Leistungsindex
 * und in der Prozessfolge.
 */
interface Props {
  label: string;
  class?: string;
}
const { label, class: klasse = '' } = Astro.props;
---

<p class:list={['vermessung steig', klasse]}>{label}</p>
