---
import Marke from './Marke.astro';
import { formularWerte } from '../data/inhalte';
import { site, cta } from '../config/site';

interface Props {
  nr?: string;
  /** Auf /kontakt ohne wiederholte Argumentation. */
  knapp?: boolean;
}
const { nr = '10', knapp = false } = Astro.props;
---

<section
  id="potenzialanalyse"
  class="abschnitt border-t border-linie bg-blei"
  aria-labelledby="anfrage-titel"
>
  <div class="shell">
    <div class="grid gap-y-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-3">
        <Marke nr={nr} label="Potenzialanalyse" />
        {
          !knapp && (
            <div class="steig mt-10 hidden lg:block" style="--i:2">
              <p class="font-mono text-[0.6rem] tracking-[0.14em] text-zink uppercase">
                Was danach passiert
              </p>
              <ol class="mt-4 space-y-3">
                {[
                  'Wir sehen uns Ihr Einzugsgebiet an.',
                  'Wir melden uns innerhalb eines Werktags.',
                  'Sie bekommen eine ehrliche Einschätzung — auch wenn sie negativ ausfällt.',
                ].map((s, i) => (
                  <li class="flex gap-3 text-[0.82rem] leading-snug text-zink">
                    <span class="font-mono text-[0.62rem] text-schnur-hell">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    {s}
                  </li>
                ))}
              </ol>
            </div>
          )
        }
      </div>

      <div class="lg:col-span-9 xl:col-span-8">
        <h2 id="anfrage-titel" class="steig text-display">
          Sehen wir uns Ihr <span class="text-schnur-hell">Einzugsgebiet</span> an.
        </h2>
        <p class="steig measure-wide mt-7 text-lead text-zink-hell" style="--i:1">
          Elf kurze Fragen. Sie sind der Grund, warum das Gespräch danach in vierzig
          Minuten zu einem Ergebnis kommt und nicht bei „erzählen Sie mal" beginnt.
        </p>

        <form
          data-anfrage
          method="POST"
          action="/api/anfrage"
          novalidate={false}
          class="mt-12"
        >
          <!-- Fortschritt als Bemaßungslinie statt als Fortschrittsbalken -->
          <div class="mb-9">
            <div class="flex items-baseline justify-between">
              <span
                data-schritt-zaehler
                class="font-mono text-[0.62rem] tracking-[0.16em] text-schnur-hell uppercase"
              >
                Ihre Angaben
              </span>
              <span class="font-mono text-[0.62rem] tracking-[0.16em] text-zink uppercase">
                Pflichtfelder mit *
              </span>
            </div>
            <div class="mt-3 h-px w-full bg-linie">
              <div
                data-schritt-balken
                class="h-px w-full origin-left bg-schnur transition-transform duration-700 [transition-timing-function:var(--ease-schnur)]"
              >
              </div>
            </div>
          </div>

          <!-- ================= Schritt 1 ================= -->
          <fieldset data-schritt class="border-0 p-0">
            <legend class="mb-7 text-statement">Ihr Betrieb</legend>

            <div class="grid gap-7 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <label class="feld-label" for="betrieb">Wie heißt Ihr Betrieb? *</label>
                <input
                  class="feld"
                  id="betrieb"
                  name="betrieb"
                  type="text"
                  required
                  autocomplete="organization"
                  maxlength="120"
                />
              </div>

              <div>
                <label class="feld-label" for="website">Website</label>
                <input
                  class="feld"
                  id="website"
                  name="website"
                  type="text"
                  inputmode="url"
                  placeholder="falls vorhanden"
                  autocomplete="url"
                  maxlength="200"
                />
              </div>

              <div>
                <label class="feld-label" for="ort">Standort oder PLZ *</label>
                <input
                  class="feld"
                  id="ort"
                  name="ort"
                  type="text"
                  required
                  autocomplete="postal-code"
                  maxlength="120"
                />
              </div>

              <div>
                <label class="feld-label" for="mitarbeiter">Mitarbeiter</label>
                <select class="feld" id="mitarbeiter" name="mitarbeiter">
                  <option value="">Bitte wählen</option>
                  {formularWerte.mitarbeiter.map((m) => <option value={m}>{m}</option>)}
                </select>
              </div>
            </div>
          </fieldset>

          <!-- ================= Schritt 2 ================= -->
          <fieldset data-schritt class="mt-14 border-0 p-0">
            <legend class="mb-7 text-statement">Ihr Ziel</legend>

            <div class="space-y-9">
              <div data-pflichtgruppe>
                <p class="feld-label" id="leistungen-label">
                  Welche Leistungen möchten Sie stärker verkaufen? *
                </p>
                <div
                  class="mt-3 grid gap-2 sm:grid-cols-2"
                  role="group"
                  aria-labelledby="leistungen-label"
                >
                  {
                    formularWerte.leistungen.map((l) => (
                      <label class="wahl">
                        <input type="checkbox" name="leistungen" value={l} />
                        <span class="wahl-kasten" aria-hidden="true" />
                        <span>{l}</span>
                      </label>
                    ))
                  }
                </div>
                <span class="fehler" data-gruppenfehler role="status" aria-live="polite"></span>
              </div>

              <div data-pflichtgruppe>
                <p class="feld-label" id="kapazitaet-label">
                  Wie viele zusätzliche Aufträge könnten Sie in den nächsten drei Monaten
                  annehmen? *
                </p>
                <div
                  class="mt-3 grid gap-2 sm:grid-cols-2"
                  role="radiogroup"
                  aria-labelledby="kapazitaet-label"
                >
                  {
                    formularWerte.kapazitaet.map((k) => (
                      <label class="wahl">
                        <input type="radio" name="kapazitaet" value={k} required />
                        <span class="wahl-kasten" aria-hidden="true" />
                        <span>{k}</span>
                      </label>
                    ))
                  }
                </div>
                <span class="fehler" data-gruppenfehler role="status" aria-live="polite"></span>
              </div>

              <div class="grid gap-7 sm:grid-cols-2">
                <div>
                  <label class="feld-label" for="herkunft">
                    Wie gewinnen Sie heute die meisten Kunden?
                  </label>
                  <select class="feld" id="herkunft" name="kundenherkunft">
                    <option value="">Bitte wählen</option>
                    {formularWerte.herkunft.map((h) => <option value={h}>{h}</option>)}
                  </select>
                </div>

                <div>
                  <p class="feld-label" id="werbung-label">Nutzen Sie bereits Werbung?</p>
                  <div class="mt-3 grid gap-2" role="group" aria-labelledby="werbung-label">
                    {
                      formularWerte.werbung.map((w) => (
                        <label class="wahl">
                          <input type="checkbox" name="werbung" value={w} />
                          <span class="wahl-kasten" aria-hidden="true" />
                          <span>{w}</span>
                        </label>
                      ))
                    }
                  </div>
                </div>
              </div>
            </div>
          </fieldset>

          <!-- ================= Schritt 3 ================= -->
          <fieldset data-schritt class="mt-14 border-0 p-0">
            <legend class="mb-7 text-statement">Kontakt</legend>

            <div class="grid gap-7 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <label class="feld-label" for="name">Ansprechpartner *</label>
                <input
                  class="feld"
                  id="name"
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                  maxlength="120"
                />
              </div>

              <div>
                <label class="feld-label" for="telefon">Telefon *</label>
                <input
                  class="feld"
                  id="telefon"
                  name="telefon"
                  type="tel"
                  required
                  autocomplete="tel"
                  maxlength="60"
                />
              </div>

              <div>
                <label class="feld-label" for="email">E-Mail *</label>
                <input
                  class="feld"
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  maxlength="160"
                />
              </div>

              <div class="sm:col-span-2">
                <p class="feld-label" id="erreichbar-label">
                  Wann erreichen wir Sie am besten?
                </p>
                <div
                  class="mt-3 grid gap-2 sm:grid-cols-4"
                  role="radiogroup"
                  aria-labelledby="erreichbar-label"
                >
                  {
                    formularWerte.erreichbar.map((e) => (
                      <label class="wahl">
                        <input type="radio" name="erreichbar" value={e} />
                        <span class="wahl-kasten" aria-hidden="true" />
                        <span>{e}</span>
                      </label>
                    ))
                  }
                </div>
                <p class="mt-2 text-[0.78rem] text-zink">
                  Wir wissen, dass Sie tagsüber nicht am Schreibtisch sitzen.
                </p>
              </div>

              <div class="sm:col-span-2">
                <label class="feld-label" for="nachricht">Anmerkung</label>
                <textarea class="feld" id="nachricht" name="nachricht" rows="3" maxlength="2000"
                ></textarea>
              </div>
            </div>

            <!-- Einwilligung: nicht vorbelegt, eigener Absatz, verlinkte Erklärung -->
            <div class="mt-9">
              <label class="flex cursor-pointer items-start gap-3.5">
                <input
                  type="checkbox"
                  name="einwilligung"
                  required
                  value="ja"
                  class="mt-1 h-4 w-4 shrink-0 accent-schnur"
                />
                <span class="text-[0.85rem] leading-relaxed text-zink-hell">
                  Ich habe die <a
                    href="/datenschutz"
                    class="text-schnur-hell underline underline-offset-4">Datenschutzerklärung</a
                  > gelesen und bin damit einverstanden, dass meine Angaben zur Bearbeitung
                  meiner Anfrage gespeichert und verarbeitet werden. *
                </span>
              </label>
            </div>

            <!-- Spamschutz ohne Captcha: kein Drittanbieter-Skript, keine
                 Übermittlung von Besucherdaten an Google. -->
            <div aria-hidden="true" class="absolute h-px w-px overflow-hidden opacity-0">
              <label for="firmenzusatz">Bitte nicht ausfüllen</label>
              <input
                id="firmenzusatz"
                name="firmenzusatz"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>
            <input type="hidden" name="geladen" data-geladen value="" />
            <div data-herkunft-felder hidden></div>
          </fieldset>

          <!-- ================= Steuerung ================= -->
          <div class="mt-12 flex flex-col gap-4 sm:flex-row sm:items-center">
            <button type="button" data-zurueck hidden class="btn btn-linie order-2 sm:order-1">
              Zurück
            </button>
            <button type="button" data-weiter hidden class="btn order-1 sm:order-2">
              Weiter
              <svg viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5" aria-hidden="true">
                <path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8"
                ></path>
              </svg>
            </button>
            <button type="submit" data-senden class="btn order-1 sm:order-2">
              {cta.primaer}
            </button>
          </div>

          <p class="mt-6 max-w-xl text-[0.82rem] leading-relaxed text-zink">
            {cta.mikro}
            {' '}
            {site.antwortzeit}
          </p>

          <p class="mt-4 max-w-xl text-[0.8rem] leading-relaxed text-zink">
            Lieber direkt sprechen?
            <a
              href={`tel:${site.telefon}`}
              data-ereignis="call_click"
              class="text-kalk underline underline-offset-4">{site.telefonAnzeige}</a
            > · {site.erreichbarkeit}. {site.emailHinweis}
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Zeitstempel für die Spamprüfung. Ohne JavaScript bleibt das Feld leer und
  // die Prüfung wird serverseitig übersprungen — das Formular bleibt nutzbar.
  document.querySelectorAll('[data-geladen]').forEach(function (el) {
    el.value = String(Date.now());
  });
</script>
