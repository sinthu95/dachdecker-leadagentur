---
import Marke from './Marke.astro';
import { formularWerte } from '../data/inhalte';
import { brancheHolen } from '../data/branchen';
import { site, cta } from '../config/site';

interface Props {
  /** Auf /kontakt ohne wiederholte Argumentation. */
  knapp?: boolean;
  /**
   * Schlüssel aus `src/data/branchen.ts`.
   *
   * Gesetzt: Die Leistungsauswahl nennt die Leistungen dieses Gewerks, und die
   * Frage lautet, was der Betrieb stärker verkaufen will. Nicht gesetzt: die
   * branchenoffene Fassung — dort kann die Seite nicht wissen, was der Betrieb
   * verkauft, also fragt sie es als Freitext und lässt stattdessen wählen,
   * woran wir zuerst arbeiten sollen.
   *
   * Es gibt bewusst nur diese eine Komponente. Zwei Formularkopien wären zwei
   * Spamschutzstellen, zwei Pflichtfeldsätze und zwei Stellen, an denen ein
   * Fehler nur zur Hälfte behoben wird.
   */
  branche?: string;
}
const { knapp = false, branche: brancheSchluessel } = Astro.props;
const branche = brancheHolen(brancheSchluessel);

const leistungsAuswahl = branche ? branche.leistungen : formularWerte.leistungenAllgemein;
const leistungsFrage = branche
  ? 'Welche Leistungen möchten Sie stärker verkaufen?'
  : 'Woran sollen wir zuerst arbeiten?';

/**
 * Die Seite, auf der dieses Formular steht — geht als `herkunft_seite` mit.
 *
 * Bewusst beim Bauen gesetzt und nicht per JavaScript: So steht der Wert auch
 * dann im abgeschickten Formular, wenn kein JavaScript läuft, und er kann nicht
 * vergessen werden, wenn eine weitere Seite ein Formular bekommt.
 *
 * Der Server glaubt dem Wert trotzdem nicht: Er prüft ihn gegen die Liste der
 * Seiten, auf denen tatsächlich ein Formular steht, und ersetzt alles andere
 * durch `/kontakt` (siehe `src/pages/api/anfrage.ts`).
 */
const seite = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<section id="potenzialanalyse" class="kapitel schnitt bg-papier" aria-labelledby="anfrage-titel">
  <div class="schiene">
    {/* Fehlerhinweis nach serverseitiger Ablehnung.

        Er stand bis Phase 4 nur auf `/kontakt` — solange auch jede Ablehnung
        dorthin umleitete, reichte das. Seit die Ablehnung zu der Seite
        zurückführt, von der die Anfrage kam, gehört der Hinweis zum Formular
        und nicht zu einer bestimmten Seite. Die Seite ist statisch, deshalb
        blendet ihn ein kleines Skript anhand der Adresse ein. */}
    <div
      id="formularfehler"
      hidden
      role="alert"
      class="mb-12 border-l border-zinnober bg-zinnober/8 px-6 py-5"
    >
      <p class="marke text-zinnober">Anfrage nicht abgeschickt</p>
      <p class="fliess mt-2 max-w-[60ch] text-klein" id="formularfehler-text"></p>
    </div>

    <div class="grid gap-x-8 gap-y-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <Marke label="Potenzialanalyse" />
        <h2 id="anfrage-titel" class="mt-8 max-w-[14ch] text-gross lg:mt-10">
          Sehen wir uns Ihr Einzugsgebiet an.
        </h2>
        <p class="steig vorspann mt-8 max-w-[38ch]" style="--i:1">
          Elf kurze Fragen. Sie sind der Grund, warum das Gespräch danach in vierzig
          Minuten zu einem Ergebnis kommt und nicht bei „erzählen Sie mal" beginnt.
        </p>

        {
          !knapp && (
            <ol class="steig mt-12 hidden border-t border-linie-stark lg:block" style="--i:2">
              {[
                'Wir sehen uns Ihr Einzugsgebiet an.',
                'Wir melden uns innerhalb eines Werktags.',
                'Sie bekommen eine ehrliche Einschätzung — auch wenn sie negativ ausfällt.',
              ].map((s, i) => (
                <li class="flex gap-5 border-b border-linie py-4">
                  <span class="marke zahlen">{String(i + 1).padStart(2, '0')}</span>
                  <span class="fliess text-klein">{s}</span>
                </li>
              ))}
            </ol>
          )
        }
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <form data-anfrage method="POST" action="/api/anfrage" class="steig" style="--i:1">
          <!-- Fortschritt als Bemaßung, nicht als Balken -->
          <div class="mb-10 border-b border-schiefer pb-3">
            <div class="flex items-baseline justify-between gap-6">
              <span data-schritt-zaehler class="marke text-schiefer">Ihre Angaben</span>
              <span class="marke">Pflichtfelder mit *</span>
            </div>
            <div class="relative mt-3 h-px w-full bg-linie">
              <div
                data-schritt-balken
                class="h-px w-full origin-left bg-schiefer transition-transform duration-1000 [transition-timing-function:var(--ease-linie)]"
              >
              </div>
            </div>
          </div>

          <!-- ================= Schritt 1 ================= -->
          <fieldset data-schritt class="border-0 p-0">
            <legend class="mb-8 text-mittel">Ihr Betrieb</legend>

            <div class="grid gap-8 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <label class="feld-label" for="betrieb">Wie heißt Ihr Betrieb? *</label>
                <input
                  class="feld"
                  id="betrieb"
                  name="betrieb"
                  type="text"
                  required
                  autocomplete="organization"
                  maxlength="120"
                />
              </div>

              <div>
                <label class="feld-label" for="website">Website</label>
                <input
                  class="feld"
                  id="website"
                  name="website"
                  type="text"
                  inputmode="url"
                  placeholder="falls vorhanden"
                  autocomplete="url"
                  maxlength="200"
                />
              </div>

              <div>
                <label class="feld-label" for="ort">Standort oder PLZ *</label>
                <input
                  class="feld"
                  id="ort"
                  name="ort"
                  type="text"
                  required
                  autocomplete="postal-code"
                  maxlength="120"
                />
              </div>

              <div>
                <label class="feld-label" for="mitarbeiter">Mitarbeiter</label>
                <select class="feld" id="mitarbeiter" name="mitarbeiter">
                  <option value="">Bitte wählen</option>
                  {formularWerte.mitarbeiter.map((m) => <option value={m}>{m}</option>)}
                </select>
              </div>

              {/* Nur auf der branchenoffenen Fassung. Auf einer Branchenseite
                  ist die Antwort bekannt — dort wäre die Frage eine, die man
                  schon beantwortet hat, und das Formular eine Zeile länger.

                  Freitext statt Auswahlliste: Eine feste Liste müsste alle
                  Branchen enthalten, für die wir arbeiten können. Die gibt es
                  nicht, und eine unvollständige Liste würde Betriebe abweisen,
                  die dazugehören. */}
              {
                !branche && (
                  <div>
                    <label class="feld-label" for="branche">
                      In welcher Branche sind Sie tätig?
                    </label>
                    <input
                      class="feld"
                      id="branche"
                      name="branche"
                      type="text"
                      placeholder="z. B. Sanitär, Gutachten, Handel"
                      maxlength="80"
                    />
                  </div>
                )
              }
            </div>
          </fieldset>

          <!-- ================= Schritt 2 ================= -->
          <fieldset data-schritt class="mt-14 border-0 p-0">
            <legend class="mb-8 text-mittel">Ihr Ziel</legend>

            <div class="space-y-10">
              <div data-pflichtgruppe>
                <p class="feld-label" id="leistungen-label">{leistungsFrage} *</p>
                <div class="mt-2 grid sm:grid-cols-2 sm:gap-x-8" role="group" aria-labelledby="leistungen-label">
                  {
                    leistungsAuswahl.map((l) => (
                      <label class="wahl">
                        <input type="checkbox" name="leistungen" value={l} />
                        <span class="wahl-marke" aria-hidden="true" />
                        <span>{l}</span>
                      </label>
                    ))
                  }
                </div>
                <span class="fehler" data-gruppenfehler role="status" aria-live="polite"></span>
              </div>

              <div data-pflichtgruppe>
                <p class="feld-label" id="kapazitaet-label">
                  Wie viele zusätzliche Aufträge könnten Sie in den nächsten drei Monaten
                  annehmen? *
                </p>
                <div
                  class="mt-2 grid sm:grid-cols-2 sm:gap-x-8"
                  role="radiogroup"
                  aria-labelledby="kapazitaet-label"
                >
                  {
                    formularWerte.kapazitaet.map((k) => (
                      <label class="wahl">
                        <input type="radio" name="kapazitaet" value={k} required />
                        <span class="wahl-marke" aria-hidden="true" />
                        <span>{k}</span>
                      </label>
                    ))
                  }
                </div>
                <span class="fehler" data-gruppenfehler role="status" aria-live="polite"></span>
              </div>

              <div class="grid gap-8 sm:grid-cols-2">
                <div>
                  <label class="feld-label" for="herkunft">
                    Wie gewinnen Sie heute die meisten Kunden?
                  </label>
                  <select class="feld" id="herkunft" name="kundenherkunft">
                    <option value="">Bitte wählen</option>
                    {formularWerte.herkunft.map((h) => <option value={h}>{h}</option>)}
                  </select>
                </div>

                <div>
                  <p class="feld-label" id="werbung-label">Nutzen Sie bereits Werbung?</p>
                  <div class="mt-2" role="group" aria-labelledby="werbung-label">
                    {
                      formularWerte.werbung.map((w) => (
                        <label class="wahl">
                          <input type="checkbox" name="werbung" value={w} />
                          <span class="wahl-marke" aria-hidden="true" />
                          <span>{w}</span>
                        </label>
                      ))
                    }
                  </div>
                </div>
              </div>
            </div>
          </fieldset>

          <!-- ================= Schritt 3 ================= -->
          <fieldset data-schritt class="mt-14 border-0 p-0">
            <legend class="mb-8 text-mittel">Kontakt</legend>

            <div class="grid gap-8 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <label class="feld-label" for="name">Ansprechpartner *</label>
                <input
                  class="feld"
                  id="name"
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                  maxlength="120"
                />
              </div>

              <div>
                <label class="feld-label" for="telefon">Telefon *</label>
                <input
                  class="feld"
                  id="telefon"
                  name="telefon"
                  type="tel"
                  required
                  autocomplete="tel"
                  maxlength="60"
                />
              </div>

              <div>
                <label class="feld-label" for="email">E-Mail *</label>
                <input
                  class="feld"
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  maxlength="160"
                />
              </div>

              <div class="sm:col-span-2">
                <p class="feld-label" id="erreichbar-label">
                  Wann erreichen wir Sie am besten?
                </p>
                <div
                  class="mt-2 grid sm:grid-cols-2 sm:gap-x-8"
                  role="radiogroup"
                  aria-labelledby="erreichbar-label"
                >
                  {
                    formularWerte.erreichbar.map((e) => (
                      <label class="wahl">
                        <input type="radio" name="erreichbar" value={e} />
                        <span class="wahl-marke" aria-hidden="true" />
                        <span>{e}</span>
                      </label>
                    ))
                  }
                </div>
                <p class="mt-3 text-[0.8rem] text-graphit">
                  Wir wissen, dass Sie tagsüber nicht am Schreibtisch sitzen.
                </p>
              </div>

              <div class="sm:col-span-2">
                <label class="feld-label" for="nachricht">Anmerkung</label>
                <textarea class="feld" id="nachricht" name="nachricht" rows="3" maxlength="2000"
                ></textarea>
              </div>
            </div>

            <div class="mt-10">
              <label class="flex cursor-pointer items-start gap-3.5">
                <input
                  type="checkbox"
                  name="einwilligung"
                  required
                  value="ja"
                  class="mt-1 h-4 w-4 shrink-0 accent-schiefer"
                />
                <span class="fliess text-[0.85rem] leading-relaxed">
                  Ich habe die <a href="/datenschutz">Datenschutzerklärung</a> gelesen und bin
                  damit einverstanden, dass meine Angaben zur Bearbeitung meiner Anfrage
                  gespeichert und verarbeitet werden. *
                </span>
              </label>
            </div>

            <!-- Spamschutz ohne Captcha: kein Drittanbieter-Skript -->
            <div aria-hidden="true" class="absolute h-px w-px overflow-hidden opacity-0">
              <label for="firmenzusatz">Bitte nicht ausfüllen</label>
              <input
                id="firmenzusatz"
                name="firmenzusatz"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>
            <input type="hidden" name="geladen" data-geladen value="" />
            <!-- Beim Bauen gesetzt, damit die Angabe auch ohne JavaScript
                 mitgeht. Der Server prüft sie gegen eine feste Liste. -->
            <input type="hidden" name="herkunft_seite" data-seite value={seite} />
            <div data-herkunft-felder hidden></div>
          </fieldset>

          <!-- ================= Steuerung ================= -->
          <div class="mt-12 flex flex-col gap-4 sm:flex-row sm:items-center">
            <button type="button" data-zurueck hidden class="knopf knopf-linie order-2 sm:order-1">
              Zurück
            </button>
            <button type="button" data-weiter hidden class="knopf order-1 sm:order-2">
              Weiter
              <svg viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5" aria-hidden="true">
                <path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6"></path>
              </svg>
            </button>
            <button type="submit" data-senden class="knopf order-1 sm:order-2">
              {cta.primaer}
            </button>
          </div>

          <p class="fliess mt-7 max-w-[52ch] text-[0.85rem]">
            {cta.mikro} {site.antwortzeit}
          </p>

          <p class="fliess mt-3 max-w-[52ch] text-[0.82rem]">
            Lieber direkt sprechen? <a href={`tel:${site.telefon}`} data-ereignis="call_click"
              >{site.telefonAnzeige}</a
            > · {site.erreichbarkeit}. {site.emailHinweis}
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Zeitstempel für die Spamprüfung. Ohne JavaScript bleibt das Feld leer und
  // die Prüfung wird serverseitig übersprungen — das Formular bleibt nutzbar.
  document.querySelectorAll('[data-geladen]').forEach(function (el) {
    el.value = String(Date.now());
  });

  // Fehlerhinweis nach serverseitiger Ablehnung. Steht bewusst hier und nicht
  // im Hauptskript: Wer nach einer Ablehnung zurückkommt, soll den Grund auch
  // dann sehen, wenn das Modul noch lädt oder gar nicht lädt.
  (function () {
    var meldungen = {
      pflichtfelder:
        'Es fehlt noch eine Pflichtangabe: Betrieb, Standort, Ihre Auswahl im Abschnitt „Ihr Ziel", Kapazität, Ansprechpartner, Telefon, E-Mail oder die Einwilligung zum Datenschutz. Ihre Eingaben stehen weiter im Formular.',
      format: 'Die Anfrage konnte technisch nicht gelesen werden. Bitte versuchen Sie es erneut.',
    };
    var art = new URLSearchParams(window.location.search).get('fehler');
    if (!art) return;
    var kasten = document.getElementById('formularfehler');
    var text = document.getElementById('formularfehler-text');
    if (!kasten || !text) return;
    text.textContent = meldungen[art] || meldungen.format;
    kasten.hidden = false;
    kasten.scrollIntoView({ block: 'center' });
  })();
</script>
