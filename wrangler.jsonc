{
  "$schema": "node_modules/wrangler/config-schema.json",

  // --------------------------------------------------------------------
  // Diese Datei gehört dem Worker `ss-leadcraft` — nicht der laufenden
  // Website.
  //
  // Ausgeliefert wird seit dem 17.08.2026 über Cloudflare **Pages**
  // (Projekt `dachdecker-leadagentur-pages`, Adresse www.ssleadcraft.de).
  // Der Worker besteht unverändert weiter, wird aber von keinem Ablauf mehr
  // beliefert und trägt keine eigene Domain. `npm run deploy` zielt auf ihn,
  // nicht auf die Produktion.
  //
  // Für Pages ist diese Datei ohne Wirkung: Wrangler meldet beim Ausspielen,
  // dass es sie gefunden hat und übergeht — genau das soll es tun. Die
  // Pages-Bindungen hängen am Projekt bei Cloudflare, gesetzt über die
  // REST-API; was das Projekt ausmacht, steht in `tools/pages-konfig.mjs`.
  //
  // Hier darf **kein** `pages_build_output_dir` hinein. Damit hielte Wrangler
  // die Datei für ein Pages-Projekt, und `npm run deploy` wäre kaputt.
  //
  // Ob der Worker-Weg bleibt oder abgebaut wird, ist nicht entschieden
  // (siehe CLAUDE.md, „Bekannte offene Punkte").
  // --------------------------------------------------------------------

  // Astro baut mit dem Cloudflare-Adapter: statische Seiten unter dist/ und
  // einen schlanken Worker, der ausschließlich POST /api/anfrage bedient.
  // Alles andere wird direkt als statisches Asset ausgeliefert.
  "name": "ss-leadcraft",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],

  // dist/ liegt nicht im Repository — es ist ein Build-Ergebnis. Ohne diesen
  // Schritt läuft "wrangler deploy" in einer frisch ausgecheckten Umgebung ins
  // Leere und meldet: The entry-point file at "dist/_worker.js/index.js" was
  // not found. Wrangler führt diesen Befehl vor jedem deploy und dev selbst
  // aus, unabhängig davon, was in der Cloudflare-Oberfläche als Build-Befehl
  // hinterlegt ist.
  "build": {
    "command": "npm run build"
  },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Ohne diese Einstellung antwortet /leistungen mit 307 auf /leistungen/ —
    // eine zusaetzliche Rundreise bei jedem internen Klick.
    "html_handling": "drop-trailing-slash",
    // Unbekannte Adressen sollen die gestaltete Fehlerseite bekommen,
    // nicht die nackte Standardmeldung.
    "not_found_handling": "404-page",
    // Wichtig: Mit "404-page" beansprucht die Asset-Schicht jeden Pfad und
    // beantwortet ein POST auf /api/anfrage mit 405, ohne den Worker je zu
    // fragen. Diese Pfade muessen deshalb zuerst an den Worker gehen.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },

  // --------------------------------------------------------------------
  // Ablage der Anfragen. Ohne diese Bindung gibt es keinen dauerhaften
  // Speicher: Der Endpunkt legt jede geprüfte Anfrage zuerst hier ab, noch
  // bevor eine Benachrichtigung versucht wird. Fehlte sie, bliebe als letzter
  // Ausweg nur das Worker-Protokoll, und das ist kein Speicher — es wird nach
  // wenigen Tagen verworfen.
  //
  // Die Bindung muss hier stehen, nicht nur in der Cloudflare-Oberfläche:
  // Beim Deploy ist diese Datei maßgeblich, und was hier fehlt, wird am Worker
  // entfernt. Die ID ist kein Geheimnis, sie benennt nur den Namensraum.
  // --------------------------------------------------------------------
  "kv_namespaces": [{ "binding": "LEADS", "id": "71bb7eb8ae0d4c659ace074645a6a72c" }],

  // --------------------------------------------------------------------
  // Benachrichtigung per E-Mail — auf dem Pages-Weg eingerichtet, auf diesem
  // Weg nicht.
  //
  // Der Endpunkt liest RESEND_API_KEY, LEAD_NOTIFY_EMAIL und LEAD_FROM_EMAIL
  // zur Laufzeit; fehlt einer der drei, wird nichts versendet. Am
  // Pages-Projekt hängen sie und der Versand ist nachgewiesen. An diesem
  // Worker hängen sie nicht: Er wird nicht mehr beliefert, und Werte für eine
  // Auslieferung anzulegen, die nicht stattfindet, hieße den Zugang an einer
  // zweiten Stelle zu führen.
  //
  // Würde der Worker-Weg wieder aufgenommen, dann so — als Secret, nicht als
  // Variable: Der „vars"-Block unten ist beim Deploy maßgeblich und würde im
  // Dashboard gesetzte Klartextvariablen wieder entfernen. Secrets bleiben.
  //
  //   npx wrangler secret put RESEND_API_KEY      Zugang zu Resend
  //   npx wrangler secret put LEAD_NOTIFY_EMAIL   Posteingang
  //   npx wrangler secret put LEAD_FROM_EMAIL     Absender, verifizierte Domain
  //
  // Die Anfrage wäre auch ohne diesen Schritt sicher abgelegt — sie käme dann
  // nur nicht von selbst an.
  // --------------------------------------------------------------------

  // --------------------------------------------------------------------
  // Domain. PUBLIC_SITE_URL wird beim Bauen gelesen, nicht zur Laufzeit.
  //
  // Auf dem Pages-Weg steht der Wert als GitHub-Actions-Variable, weil dort
  // gebaut wird — nicht bei Cloudflare. Dieser Block gilt nur für
  // `npm run deploy`; er bleibt leer, damit ein Worker-Deploy nicht
  // versehentlich eine zweite indexierbare Fassung derselben Seite ins Netz
  // stellt, die mit www.ssleadcraft.de um dieselben Suchbegriffe konkurriert.
  //
  // Folge: Ein Deploy von hier baut bewusst mit noindex und ohne Sitemap.
  // --------------------------------------------------------------------
  "vars": {
    "PUBLIC_SITE_URL": ""
  }
}
